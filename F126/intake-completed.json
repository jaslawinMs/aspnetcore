    "tfm_sensitive": false,
    "summary": "The sample policy provider reparses and rebuilds recurring named policies.",
    "explanation": "For every matching GetPolicyAsync call, the provider allocates a suffix with Substring, parses the same endpoint policy age, creates a new AuthorizationPolicyBuilder and requirement, and builds a new policy. The assigned IAuthorizationPolicyProvider uses a default AllowsCachingPolicies value of false, so AuthorizationMiddleware does not enable its endpoint policy cache for this provider. Repeated requests for a bounded policy name therefore repeat the parsing and construction work.",
    "snippet": "int.TryParse(policyName.Substring(POLICY_PREFIX.Length), out var age)\n...\nvar policy = new AuthorizationPolicyBuilder();\npolicy.AddRequirements(new MinimumAgeRequirement(age));\nreturn Task.FromResult(policy.Build());",
    "suppressed": false
  },
