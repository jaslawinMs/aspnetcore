<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net12.0</TargetFramework>
    <RuntimeFrameworkVersion>12.0.0-alpha.1.26562.105</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <Optimize>true</Optimize>
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <BuildProjectReferences>false</BuildProjectReferences>
    <BuildInParallel>false</BuildInParallel>
    <UseSharedCompilation>false</UseSharedCompilation>
    <AspNetCoreRoot Condition="'$(AspNetCoreRoot)' == ''">C:\src\aspnetcore</AspNetCoreRoot>
    <TestBin>$(AspNetCoreRoot)\artifacts\bin\AuthSamples.FunctionalTests\Release\net12.0</TestBin>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.13.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="12.0.0-alpha.1.26562.105" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="12.0.0-alpha.1.26562.105" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="12.0.0-alpha.1.26562.105" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Security\samples\CustomPolicyProvider\CustomPolicyProvider.csproj" />
    <Reference Include="$(TestBin)\Microsoft.AspNetCore*.dll;$(TestBin)\Microsoft.Extensions*.dll"
      Exclude="$(TestBin)\*Test*.dll;$(TestBin)\*Analyzers*.dll;$(TestBin)\*CodeFixes*.dll;$(TestBin)\*Generator*.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(TestBin)\Microsoft.AspNetCore.TestHost.dll">
      <Private>true</Private>
    </Reference>
    <None Update="profile-definitions.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ValidateSourceInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(TestBin)\Microsoft.AspNetCore.TestHost.dll')" Text="First build the actual sample functional-test graph; no installed ASP.NET Core substitution." />
  </Target>
</Project>
