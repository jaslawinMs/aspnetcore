+    private sealed class UnmetDiagnosticRequirement(string text) : IAuthorizationRequirement
+    {
+        public int ToStringCalls { get; set; }
+
+        public override string ToString()
+        {
+            ToStringCalls++;
+
+            return text;
+        }
+    }
