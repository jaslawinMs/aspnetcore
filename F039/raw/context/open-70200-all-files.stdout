[[{"sha":"76a544436582dbfa3dbb5413392a84de93d21279","filename":"src/Http/WebUtilities/perf/Microbenchmarks/QueryHelpersAddQueryStringBenchmark.cs","status":"added","additions":38,"deletions":0,"changes":38,"blob_url":"https://github.com/dotnet/aspnetcore/blob/70459f6f017e27bb9b799f9a6200dd40fbda6c90/src%2FHttp%2FWebUtilities%2Fperf%2FMicrobenchmarks%2FQueryHelpersAddQueryStringBenchmark.cs","raw_url":"https://github.com/dotnet/aspnetcore/raw/70459f6f017e27bb9b799f9a6200dd40fbda6c90/src%2FHttp%2FWebUtilities%2Fperf%2FMicrobenchmarks%2FQueryHelpersAddQueryStringBenchmark.cs","contents_url":"https://api.github.com/repos/dotnet/aspnetcore/contents/src%2FHttp%2FWebUtilities%2Fperf%2FMicrobenchmarks%2FQueryHelpersAddQueryStringBenchmark.cs?ref=70459f6f017e27bb9b799f9a6200dd40fbda6c90","patch":"@@ -0,0 +1,38 @@\n+// Licensed to the .NET Foundation under one or more agreements.\n+// The .NET Foundation licenses this file to you under the MIT license.\n+\n+using BenchmarkDotNet.Attributes;\n+\n+namespace Microsoft.AspNetCore.WebUtilities.Microbenchmarks;\n+\n+[MemoryDiagnoser]\n+public class QueryHelpersAddQueryStringBenchmark\n+{\n+    private readonly Dictionary<string, string> _oauth = new()\n+    {\n+        [\"client_id\"] = \"0123456789abcdef\",\n+        [\"scope\"] = \"openid profile email\",\n+        [\"response_type\"] = \"code\",\n+        [\"redirect_uri\"] = \"https://localhost:5001/signin-oidc\",\n+        [\"state\"] = \"CfDJ8Abcdefghijklmnopqrstuvwxyz0123456789-_ABCDEFGHIJKLMNOPQRSTUVWXYZ\",\n+        [\"code_challenge\"] = \"E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM\",\n+        [\"code_challenge_method\"] = \"S256\",\n+    };\n+\n+    private readonly string _longValue = string.Concat(Enumerable.Repeat(\"CfDJ8Abcdefghijklmnopqrstuvwxyz0123456789-_\", 14));\n+\n+    [Benchmark]\n+    public string ReturnUrl() => QueryHelpers.AddQueryString(\"/Account/Login\", \"ReturnUrl\", \"/orders/details?id=42\");\n+\n+    [Benchmark]\n+    public string Simple() => QueryHelpers.AddQueryString(\"/api/items\", \"page\", \"2\");\n+\n+    [Benchmark]\n+    public string LongValue() => QueryHelpers.AddQueryString(\"/signin-oidc\", \"state\", _longValue);\n+\n+    [Benchmark]\n+    public string EncodeHeavy() => QueryHelpers.AddQueryString(\"/search\", \"q\", \"caf\\u00e9 & cr\\u00e8me br\\u00fbl\\u00e9e / \\u4e2d\\u6587?#\");\n+\n+    [Benchmark]\n+    public string OAuth() => QueryHelpers.AddQueryString(\"https://login.example.com/oauth2/v2.0/authorize\", _oauth);\n+}"},{"sha":"982d349f783fe53943bebda01ffbcb5cd3ec2334","filename":"src/Http/WebUtilities/src/Microsoft.AspNetCore.WebUtilities.csproj","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/dotnet/aspnetcore/blob/70459f6f017e27bb9b799f9a6200dd40fbda6c90/src%2FHttp%2FWebUtilities%2Fsrc%2FMicrosoft.AspNetCore.WebUtilities.csproj","raw_url":"https://github.com/dotnet/aspnetcore/raw/70459f6f017e27bb9b799f9a6200dd40fbda6c90/src%2FHttp%2FWebUtilities%2Fsrc%2FMicrosoft.AspNetCore.WebUtilities.csproj","contents_url":"https://api.github.com/repos/dotnet/aspnetcore/contents/src%2FHttp%2FWebUtilities%2Fsrc%2FMicrosoft.AspNetCore.WebUtilities.csproj?ref=70459f6f017e27bb9b799f9a6200dd40fbda6c90","patch":"@@ -17,6 +17,7 @@\n     <Compile Include=\"$(SharedSourceRoot)PooledMemoryStream.cs\" />\n     <Compile Include=\"$(SharedSourceRoot)WebEncoders\\**\\*.cs\" />\n     <Compile Include=\"$(SharedSourceRoot)UrlDecoder\\**\\*.cs\" />\n+    <Compile Include=\"$(SharedSourceRoot)ValueStringBuilder\\ValueStringBuilder.cs\" LinkBase=\"Shared\" />\n     <Compile Include=\"$(SharedSourceRoot)ThrowHelpers\\ArgumentNullThrowHelper.cs\" LinkBase=\"Shared\" />\n     <Compile Include=\"$(SharedSourceRoot)ThrowHelpers\\ArgumentOutOfRangeThrowHelper.cs\" LinkBase=\"Shared\" />\n     <Compile Include=\"$(SharedSourceRoot)CallerArgument\\CallerArgumentExpressionAttribute.cs\" LinkBase=\"Shared\" />"},{"sha":"a137f2b6ec1e888856d28da9785b51c366633287","filename":"src/Http/WebUtilities/src/QueryHelpers.cs","status":"modified","additions":94,"deletions":14,"changes":108,"blob_url":"https://github.com/dotnet/aspnetcore/blob/70459f6f017e27bb9b799f9a6200dd40fbda6c90/src%2FHttp%2FWebUtilities%2Fsrc%2FQueryHelpers.cs","raw_url":"https://github.com/dotnet/aspnetcore/raw/70459f6f017e27bb9b799f9a6200dd40fbda6c90/src%2FHttp%2FWebUtilities%2Fsrc%2FQueryHelpers.cs","contents_url":"https://api.github.com/repos/dotnet/aspnetcore/contents/src%2FHttp%2FWebUtilities%2Fsrc%2FQueryHelpers.cs?ref=70459f6f017e27bb9b799f9a6200dd40fbda6c90","patch":"@@ -1,6 +1,8 @@\n // Licensed to the .NET Foundation under one or more agreements.\n // The .NET Foundation licenses this file to you under the MIT license.\n \n+using System.Buffers;\n+using System.Diagnostics;\n using System.Linq;\n using System.Text;\n using System.Text.Encodings.Web;\n@@ -13,6 +15,8 @@ namespace Microsoft.AspNetCore.WebUtilities;\n /// </summary>\n public static class QueryHelpers\n {\n+    private const int StackallocCharThreshold = 256;\n+\n     /// <summary>\n     /// Append the given query key and value to the URI.\n     /// </summary>\n@@ -29,8 +33,26 @@ public static string AddQueryString(string uri, string name, string value)\n         ArgumentNullException.ThrowIfNull(name);\n         ArgumentNullException.ThrowIfNull(value);\n \n-        return AddQueryString(\n-            uri, new[] { new KeyValuePair<string, string?>(name, value) });\n+        var anchorIndex = uri.IndexOf('#');\n+        var baseLength = anchorIndex < 0 ? uri.Length : anchorIndex;\n+        var separator = uri.AsSpan(0, baseLength).Contains('?') ? \"&\" : \"?\";\n+\n+        var builder = new ValueStringBuilder(stackalloc char[StackallocCharThreshold]);\n+        char[]? rentedBuffer = null;\n+        try\n+        {\n+            Append(ref builder, ref rentedBuffer, uri.AsSpan(0, baseLength));\n+            Append(ref builder, ref rentedBuffer, separator);\n+            AppendUrlEncoded(ref builder, ref rentedBuffer, name);\n+            Append(ref builder, ref rentedBuffer, \"=\");\n+            AppendUrlEncoded(ref builder, ref rentedBuffer, value);\n+            Append(ref builder, ref rentedBuffer, uri.AsSpan(baseLength));\n+            return builder.AsSpan().ToString();\n+        }\n+        finally\n+        {\n+            ReturnRentedBuffer(builder.Length, rentedBuffer);\n+        }\n     }\n \n     /// <summary>\n@@ -93,24 +115,82 @@ public static string AddQueryString(\n         var queryIndex = uriToBeAppended.IndexOf('?');\n         var hasQuery = queryIndex != -1;\n \n-        var sb = new StringBuilder();\n-        sb.Append(uriToBeAppended);\n-        foreach (var parameter in queryString)\n+        var builder = new ValueStringBuilder(stackalloc char[StackallocCharThreshold]);\n+        char[]? rentedBuffer = null;\n+        try\n+        {\n+            Append(ref builder, ref rentedBuffer, uriToBeAppended);\n+            foreach (var parameter in queryString)\n+            {\n+                if (parameter.Value is null)\n+                {\n+                    continue;\n+                }\n+\n+                Append(ref builder, ref rentedBuffer, hasQuery ? \"&\" : \"?\");\n+                AppendUrlEncoded(ref builder, ref rentedBuffer, parameter.Key);\n+                Append(ref builder, ref rentedBuffer, \"=\");\n+                AppendUrlEncoded(ref builder, ref rentedBuffer, parameter.Value);\n+                hasQuery = true;\n+            }\n+\n+            Append(ref builder, ref rentedBuffer, anchorText);\n+            return builder.AsSpan().ToString();\n+        }\n+        finally\n+        {\n+            ReturnRentedBuffer(builder.Length, rentedBuffer);\n+        }\n+    }\n+\n+    // ValueStringBuilder's own growth returns pooled arrays without clearing them, and query values may\n+    // contain sensitive data, so growth is done here and the builder only ever writes into a buffer it does not own.\n+    private static void Append(ref ValueStringBuilder builder, ref char[]? rentedBuffer, ReadOnlySpan<char> value)\n+    {\n+        if (value.Length > builder.Capacity - builder.Length)\n+        {\n+            Grow(ref builder, ref rentedBuffer, value.Length);\n+        }\n+\n+        builder.Append(value);\n+    }\n+\n+    private static void AppendUrlEncoded(ref ValueStringBuilder builder, ref char[]? rentedBuffer, string value)\n+    {\n+        var source = value.AsSpan();\n+        while (true)\n         {\n-            if (parameter.Value == null)\n+            var status = UrlEncoder.Default.Encode(source, builder.RawChars.Slice(builder.Length), out var charsConsumed, out var charsWritten, isFinalBlock: true);\n+            builder.Length += charsWritten;\n+            if (status != OperationStatus.DestinationTooSmall)\n             {\n-                continue;\n+                Debug.Assert(status == OperationStatus.Done);\n+                return;\n             }\n \n-            sb.Append(hasQuery ? '&' : '?');\n-            sb.Append(UrlEncoder.Default.Encode(parameter.Key));\n-            sb.Append('=');\n-            sb.Append(UrlEncoder.Default.Encode(parameter.Value));\n-            hasQuery = true;\n+            source = source.Slice(charsConsumed);\n+            Grow(ref builder, ref rentedBuffer, source.Length);\n         }\n+    }\n+\n+    private static void Grow(ref ValueStringBuilder builder, ref char[]? rentedBuffer, int additionalCapacity)\n+    {\n+        var length = builder.Length;\n+        var newBuffer = ArrayPool<char>.Shared.Rent((int)Math.Max((uint)(length + additionalCapacity), (uint)builder.Capacity * 2));\n+        builder.AsSpan().CopyTo(newBuffer);\n+        ReturnRentedBuffer(length, rentedBuffer);\n+        rentedBuffer = newBuffer;\n+        builder = new ValueStringBuilder(newBuffer);\n+        builder.Length = length;\n+    }\n \n-        sb.Append(anchorText);\n-        return sb.ToString();\n+    private static void ReturnRentedBuffer(int length, char[]? rentedBuffer)\n+    {\n+        if (rentedBuffer is not null)\n+        {\n+            rentedBuffer.AsSpan(0, length).Clear();\n+            ArrayPool<char>.Shared.Return(rentedBuffer);\n+        }\n     }\n \n     /// <summary>"},{"sha":"cb1cdcd57345cc7bc251722942db93bcdd04a6a6","filename":"src/Http/WebUtilities/test/QueryHelpersTests.cs","status":"modified","additions":65,"deletions":0,"changes":65,"blob_url":"https://github.com/dotnet/aspnetcore/blob/70459f6f017e27bb9b799f9a6200dd40fbda6c90/src%2FHttp%2FWebUtilities%2Ftest%2FQueryHelpersTests.cs","raw_url":"https://github.com/dotnet/aspnetcore/raw/70459f6f017e27bb9b799f9a6200dd40fbda6c90/src%2FHttp%2FWebUtilities%2Ftest%2FQueryHelpersTests.cs","contents_url":"https://api.github.com/repos/dotnet/aspnetcore/contents/src%2FHttp%2FWebUtilities%2Ftest%2FQueryHelpersTests.cs?ref=70459f6f017e27bb9b799f9a6200dd40fbda6c90","patch":"@@ -101,6 +101,71 @@ public void ParseEmptyOrNullQueryWorks(string? queryString)\n         Assert.Empty(collection);\n     }\n \n+    [Theory]\n+    [InlineData(\"\", \"a\", \"b\")]\n+    [InlineData(\"/path\", \"\", \"\")]\n+    [InlineData(\"/path?\", \"na me\", \"va&lue=\")]\n+    [InlineData(\"/path#frag?x=1\", \"k\", \"v\")]\n+    [InlineData(\"/path?q=1#frag#more\", \"\\u00e9\", \"\\ud83d\\ude00/?#\")]\n+    [InlineData(\"#\", \"k\", \"v\")]\n+    [InlineData(\"/path\", \"k\", \"LONG\")]\n+    [InlineData(\"/path?x=y#a\", \"LONG\", \"LONG\")]\n+    [InlineData(\"/path\", \"\\ud800\", \"a\\udc00b\")]\n+    [InlineData(\"/path\", \"k\", \"HEAVY\")]\n+    [InlineData(\"/path?k=\", \"k\", \"SPLIT\")]\n+    [InlineData(\"LONG#frag\", \"k\", \"v\")]\n+    public void AddQueryStringMatchesReferenceImplementation(string uri, string name, string value)\n+    {\n+        var longValue = string.Concat(Enumerable.Repeat(\"x y&z/\\u00e9\", 200));\n+        uri = uri.Replace(\"LONG\", longValue);\n+        name = name == \"LONG\" ? longValue : name;\n+        value = value switch\n+        {\n+            \"LONG\" => longValue,\n+            // Every char expands to nine chars, forcing several buffer growths.\n+            \"HEAVY\" => new string('\\u4e2d', 300),\n+            // Surrogate pairs that straddle the end of the initial 256-char buffer.\n+            \"SPLIT\" => new string('a', 240) + string.Concat(Enumerable.Repeat(\"\\ud83d\\ude00\", 10)),\n+            _ => value,\n+        };\n+\n+        Assert.Equal(ReferenceAddQueryString(uri, [new(name, value)]), QueryHelpers.AddQueryString(uri, name, value));\n+\n+        var pairs = new List<KeyValuePair<string, string?>>\n+        {\n+            new(name, value),\n+            new(\"skipped\", null),\n+            new(value, name),\n+            new(longValue, longValue),\n+            new(\"last\", \"\"),\n+        };\n+        Assert.Equal(ReferenceAddQueryString(uri, pairs), QueryHelpers.AddQueryString(uri, pairs));\n+    }\n+\n+    private static string ReferenceAddQueryString(string uri, IEnumerable<KeyValuePair<string, string?>> queryString)\n+    {\n+        var anchorIndex = uri.IndexOf('#');\n+        var anchorText = anchorIndex == -1 ? \"\" : uri.Substring(anchorIndex);\n+        var baseUri = anchorIndex == -1 ? uri : uri.Substring(0, anchorIndex);\n+        var hasQuery = baseUri.Contains('?');\n+        var sb = new System.Text.StringBuilder(baseUri);\n+        foreach (var parameter in queryString)\n+        {\n+            if (parameter.Value is null)\n+            {\n+                continue;\n+            }\n+\n+            sb.Append(hasQuery ? '&' : '?');\n+            sb.Append(System.Text.Encodings.Web.UrlEncoder.Default.Encode(parameter.Key));\n+            sb.Append('=');\n+            sb.Append(System.Text.Encodings.Web.UrlEncoder.Default.Encode(parameter.Value));\n+            hasQuery = true;\n+        }\n+\n+        return sb.Append(anchorText).ToString();\n+    }\n+\n     [Fact]\n     public void AddQueryStringWithNullValueThrows()\n     {"}]]