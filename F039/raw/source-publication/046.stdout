ithub.com/jaslawinMs/aspnetcore/commit/a412ffec9328562a1b7e27945f0e40ebdca3c35d"},{"sha":"a61c99060627afe844e49ed09e4d30b4311edcd9","url":"https://api.github.com/repos/jaslawinMs/aspnetcore/commits/a61c99060627afe844e49ed09e4d30b4311edcd9","html_url":"https://github.com/jaslawinMs/aspnetcore/commit/a61c99060627afe844e49ed09e4d30b4311edcd9"}]},"status":"ahead","ahead_by":1,"behind_by":0,"total_commits":1,"commits":[{"sha":"ae7b2c751c2d4ff18302779ecd6f4fa76beb0260","node_id":"C_kwDOVtqThdoAKGFlN2IyYzc1MWMyZDRmZjE4MzAyNzc5ZWNkNmY0ZmE3NmJlYjAyNjA","commit":{"author":{"name":"Jaro Slawinski","email":"jaslawin@microsoft.com","date":"2026-11-18T04:26:12Z"},"committer":{"name":"Jaro Slawinski","email":"jaslawin@microsoft.com","date":"2026-11-18T04:26:12Z"},"message":"Avoid duplicate lookups in TempData collection containment\n\nUse the private Data dictionary TryGetValue, not the consuming public member. Preserve lazy loading, null and equality semantics, and retention. Add focused eight-row lazy-load and consumed-value preservation coverage. F039 retains two completed comparisons and the first failed authorization; no cookie or application speedup claim.\n\nCo-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>\nCopilot-Session: a24edcfd-1bb9-4160-afce-6ba54b1b7f00","tree":{"sha":"7ba6183b2ee7d9ab271e9b96b327ddb320eea75c","url":"https://api.github.com/repos/jaslawinMs/aspnetcore/git/trees/7ba6183b2ee7d9ab271e9b96b327ddb320eea75c"},"url":"https://api.github.com/repos/jaslawinMs/aspnetcore/git/commits/ae7b2c751c2d4ff18302779ecd6f4fa76beb0260","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/jaslawinMs/aspnetcore/commits/ae7b2c751c2d4ff18302779ecd6f4fa76beb0260","html_url":"https://github.com/jaslawinMs/aspnetcore/commit/ae7b2c751c2d4ff18302779ecd6f4fa76beb0260","comments_url":"https://api.github.com/repos/jaslawinMs/aspnetcore/commits/ae7b2c751c2d4ff18302779ecd6f4fa76beb0260/comments","author":{"login":"jaslawinMs","id":66098041,"node_id":"MDQ6VXNlcjY2MDk4MDQx","avatar_url":"https://avatars.githubusercontent.com/u/66098041?v=4","gravatar_id":"","url":"https://api.github.com/users/jaslawinMs","html_url":"https://github.com/jaslawinMs","followers_url":"https://api.github.com/users/jaslawinMs/followers","following_url":"https://api.github.com/users/jaslawinMs/following{/other_user}","gists_url":"https://api.github.com/users/jaslawinMs/gists{/gist_id}","starred_url":"https://api.github.com/users/jaslawinMs/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jaslawinMs/subscriptions","organizations_url":"https://api.github.com/users/jaslawinMs/orgs","repos_url":"https://api.github.com/users/jaslawinMs/repos","events_url":"https://api.github.com/users/jaslawinMs/events{/privacy}","received_events_url":"https://api.github.com/users/jaslawinMs/received_events","type":"User","user_view_type":"public","site_admin":true},"committer":{"login":"jaslawinMs","id":66098041,"node_id":"MDQ6VXNlcjY2MDk4MDQx","avatar_url":"https://avatars.githubusercontent.com/u/66098041?v=4","gravatar_id":"","url":"https://api.github.com/users/jaslawinMs","html_url":"https://github.com/jaslawinMs","followers_url":"https://api.github.com/users/jaslawinMs/followers","following_url":"https://api.github.com/users/jaslawinMs/following{/other_user}","gists_url":"https://api.github.com/users/jaslawinMs/gists{/gist_id}","starred_url":"https://api.github.com/users/jaslawinMs/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jaslawinMs/subscriptions","organizations_url":"https://api.github.com/users/jaslawinMs/orgs","repos_url":"https://api.github.com/users/jaslawinMs/repos","events_url":"https://api.github.com/users/jaslawinMs/events{/privacy}","received_events_url":"https://api.github.com/users/jaslawinMs/received_events","type":"User","user_view_type":"public","site_admin":true},"parents":[{"sha":"37e809ead5824bc753a1c3d56f11615bdb1296c5","url":"https://api.github.com/repos/jaslawinMs/aspnetcore/commits/37e809ead5824bc753a1c3d56f11615bdb1296c5","html_url":"https://github.com/jaslawinMs/aspnetcore/commit/37e809ead5824bc753a1c3d56f11615bdb1296c5"}]}],"files":[{"sha":"d5222a31f46923cfd3f84026dae2b3e8dfd3cbc4","filename":"src/Components/Endpoints/src/TempData/TempData.cs","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/jaslawinMs/aspnetcore/blob/ae7b2c751c2d4ff18302779ecd6f4fa76beb0260/src%2FComponents%2FEndpoints%2Fsrc%2FTempData%2FTempData.cs","raw_url":"https://github.com/jaslawinMs/aspnetcore/raw/ae7b2c751c2d4ff18302779ecd6f4fa76beb0260/src%2FComponents%2FEndpoints%2Fsrc%2FTempData%2FTempData.cs","contents_url":"https://api.github.com/repos/jaslawinMs/aspnetcore/contents/src%2FComponents%2FEndpoints%2Fsrc%2FTempData%2FTempData.cs?ref=ae7b2c751c2d4ff18302779ecd6f4fa76beb0260","patch":"@@ -141,7 +141,7 @@ public void Clear()\n \n     bool ICollection<KeyValuePair<string, object?>>.Contains(KeyValuePair<string, object?> item)\n     {\n-        return ContainsKey(item.Key) && Equals(Peek(item.Key), item.Value);\n+        return Data.TryGetValue(item.Key, out var value) && Equals(value, item.Value);\n     }\n \n     void ICollection<KeyValuePair<string, object?>>.CopyTo(KeyValuePair<string, object?>[] array, int arrayIndex)"},{"sha":"ff00b60a549ce3ff36856f1ea7c3893a9e5eb4ca","filename":"src/Components/Endpoints/test/TempData/TempDataTest.cs","status":"modified","additions":48,"deletions":0,"changes":48,"blob_url":"https://github.com/jaslawinMs/aspnetcore/blob/ae7b2c751c2d4ff18302779ecd6f4fa76beb0260/src%2FComponents%2FEndpoints%2Ftest%2FTempData%2FTempDataTest.cs","raw_url":"https://github.com/jaslawinMs/aspnetcore/raw/ae7b2c751c2d4ff18302779ecd6f4fa76beb0260/src%2FComponents%2FEndpoints%2Ftest%2FTempData%2FTempDataTest.cs","contents_url":"https://api.github.com/repos/jaslawinMs/aspnetcore/contents/src%2FComponents%2FEndpoints%2Ftest%2FTempData%2FTempDataTest.cs?ref=ae7b2c751c2d4ff18302779ecd6f4fa76beb0260","patch":"@@ -122,6 +122,54 @@ public void ContainsKey_ReturnsFalseForNonExistentKey()\n         Assert.False(result);\n     }\n \n+    [Theory]\n+    [InlineData(\"Message\", \"hello\", true)]\n+    [InlineData(\"MESSAGE\", \"hello\", true)]\n+    [InlineData(\"Message\", \"HELLO\", false)]\n+    [InlineData(\"Message\", null, false)]\n+    [InlineData(\"Null\", null, true)]\n+    [InlineData(\"Null\", \"hello\", false)]\n+    [InlineData(\"Missing\", null, false)]\n+    [InlineData(\"Missing\", \"hello\", false)]\n+    public void CollectionContains_PreservesValues_WhenFirstAccessTriggersLazyLoad(string key, object value, bool expected)\n+    {\n+        var numberOfLoads = 0;\n+        var tempData = new TempData(() =>\n+        {\n+            numberOfLoads++;\n+            return new Dictionary<string, object>\n+            {\n+                [\"Message\"] = \"hello\",\n+                [\"Null\"] = null\n+            };\n+        });\n+        var collection = (ICollection<KeyValuePair<string, object>>)tempData;\n+        var item = new KeyValuePair<string, object>(key, value);\n+\n+        Assert.False(tempData.WasLoaded);\n+        Assert.Equal(expected, collection.Contains(item));\n+        Assert.Equal(expected, collection.Contains(item));\n+\n+        var saved = tempData.Save();\n+        Assert.Equal(1, numberOfLoads);\n+        Assert.Equal(2, saved.Count);\n+        Assert.Equal(\"hello\", saved[\"Message\"]);\n+        Assert.Null(saved[\"Null\"]);\n+    }\n+\n+    [Fact]\n+    public void CollectionContains_DoesNotRetainConsumedValue()\n+    {\n+        var tempData = CreateTempData();\n+        tempData[\"Message\"] = \"hello\";\n+        Assert.Equal(\"hello\", tempData.Get(\"Message\"));\n+        var collection = (ICollection<KeyValuePair<string, object>>)tempData;\n+\n+        Assert.True(collection.Contains(new KeyValuePair<string, object>(\"MESSAGE\", \"hello\")));\n+\n+        Assert.Empty(tempData.Save());\n+    }\n+\n     [Fact]\n     public void Remove_RemovesKeyAndReturnsTrue()\n     {"}]}