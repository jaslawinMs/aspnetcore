{"filename":"src/Mvc/Mvc.Core/src/Formatters/AcceptHeaderParser.cs","patch":"@@ -2,6 +2,7 @@\n // The .NET Foundation licenses this file to you under the MIT license.\n \n using System.Diagnostics;\n+using Microsoft.Extensions.Primitives;\n using Microsoft.Net.Http.Headers;\n \n namespace Microsoft.AspNetCore.Mvc.Formatters;\n@@ -22,28 +23,42 @@ public static void ParseAcceptHeader(IList\u003cstring\u003e acceptHeaders, IList\u003cMediaTyp\n         ArgumentNullException.ThrowIfNull(parsedValues);\n         for (var i = 0; i \u003c acceptHeaders.Count; i++)\n         {\n-            var charIndex = 0;\n-            var value = acceptHeaders[i];\n+            ParseAcceptHeaderValue(acceptHeaders[i], parsedValues);\n+        }\n+    }\n \n-            while (!string.IsNullOrEmpty(value) \u0026\u0026 charIndex \u003c value.Length)\n-            {\n-                var startCharIndex = charIndex;\n+    // Overload that avoids boxing the StringValues to IList\u003cstring\u003e.\n+    public static void ParseAcceptHeader(StringValues acceptHeaders, IList\u003cMediaTypeSegmentWithQuality\u003e parsedValues)\n+    {\n+        ArgumentNullException.ThrowIfNull(parsedValues);\n+        for (var i = 0; i \u003c acceptHeaders.Count; i++)\n+        {\n+            ParseAcceptHeaderValue(acceptHeaders[i], parsedValues);\n+        }\n+    }\n \n-                if (TryParseValue(value, ref charIndex, out var output))\n-                {\n-                    // The entry may not contain an actual value, like Accept: application/json, , */*\n-                    if (output.MediaType.HasValue)\n-                    {\n-                        parsedValues.Add(output);\n-                    }\n-                }\n+    private static void ParseAcceptHeaderValue(string? value, IList\u003cMediaTypeSegmentWithQuality\u003e parsedValues)\n+    {\n+        var charIndex = 0;\n+\n+        while (!string.IsNullOrEmpty(value) \u0026\u0026 charIndex \u003c value.Length)\n+        {\n+            var startCharIndex = charIndex;\n \n-                if (charIndex \u003c= startCharIndex)\n+            if (TryParseValue(value, ref charIndex, out var output))\n+            {\n+                // The entry may not contain an actual value, like Accept: application/json, , */*\n+                if (output.MediaType.HasValue)\n                 {\n-                    Debug.Fail(\"ParseAcceptHeader should advance charIndex, this is a bug.\");\n-                    break;\n+                    parsedValues.Add(output);\n                 }\n             }\n+\n+            if (charIndex \u003c= startCharIndex)\n+            {\n+                Debug.Fail(\"ParseAcceptHeader should advance charIndex, this is a bug.\");\n+                break;\n+            }\n         }\n     }\n "}
{"filename":"src/Mvc/Mvc.Core/src/Infrastructure/DefaultOutputFormatterSelector.cs","patch":"@@ -24,6 +24,7 @@ public partial class DefaultOutputFormatterSelector : OutputFormatterSelector\n         return left.Quality \u003e right.Quality ? -1 : (left.Quality == right.Quality ? 0 : 1);\n     };\n \n+    private const int MaxInitialAcceptCapacity = 16;\n     private readonly ILogger _logger;\n     private readonly IList\u003cIOutputFormatter\u003e _formatters;\n     private readonly bool _respectBrowserAcceptHeader;\n@@ -146,10 +147,25 @@ public DefaultOutputFormatterSelector(IOptions\u003cMvcOptions\u003e options, ILoggerFacto\n         return selectedFormatter;\n     }\n \n-    private List\u003cMediaTypeSegmentWithQuality\u003e GetAcceptableMediaTypes(HttpRequest request)\n+    private IList\u003cMediaTypeSegmentWithQuality\u003e GetAcceptableMediaTypes(HttpRequest request)\n     {\n-        var result = new List\u003cMediaTypeSegmentWithQuality\u003e();\n-        AcceptHeaderParser.ParseAcceptHeader(request.Headers.Accept, result);\n+        var acceptHeader = request.Headers.Accept;\n+        if (acceptHeader.Count == 0)\n+        {\n+            return Array.Empty\u003cMediaTypeSegmentWithQuality\u003e();\n+        }\n+\n+        // Pre-size the list using the number of comma separated entries so that the common case of a short Accept\n+        // header does not over-allocate or grow the backing array. The initial capacity is bounded so that headers\n+        // containing many empty entries don't over-allocate; the list grows as needed for longer headers.\n+        var capacity = 0;\n+        for (var i = 0; i \u003c acceptHeader.Count \u0026\u0026 capacity \u003c MaxInitialAcceptCapacity; i++)\n+        {\n+            capacity += acceptHeader[i] is { } value ? value.AsSpan().Count(',') + 1 : 0;\n+        }\n+\n+        var result = new List\u003cMediaTypeSegmentWithQuality\u003e(Math.Min(capacity, MaxInitialAcceptCapacity));\n+        AcceptHeaderParser.ParseAcceptHeader(acceptHeader, result);\n         for (var i = 0; i \u003c result.Count; i++)\n         {\n             var mediaType = new MediaType(result[i].MediaType);\n@@ -171,8 +187,9 @@ private List\u003cMediaTypeSegmentWithQuality\u003e GetAcceptableMediaTypes(HttpRequest re\n     {\n         Log.SelectFirstCanWriteFormatter(_logger);\n \n-        foreach (var formatter in formatters)\n+        for (var i = 0; i \u003c formatters.Count; i++)\n         {\n+            var formatter = formatters[i];\n             formatterContext.ContentType = new StringSegment();\n             formatterContext.ContentTypeIsServerDefined = false;\n \n@@ -215,10 +232,12 @@ private List\u003cMediaTypeSegmentWithQuality\u003e GetAcceptableMediaTypes(HttpRequest re\n         IList\u003cIOutputFormatter\u003e formatters,\n         MediaTypeCollection acceptableContentTypes)\n     {\n-        foreach (var formatter in formatters)\n+        for (var i = 0; i \u003c formatters.Count; i++)\n         {\n-            foreach (var contentType in acceptableContentTypes)\n+            var formatter = formatters[i];\n+            for (var j = 0; j \u003c acceptableContentTypes.Count; j++)\n             {\n+                var contentType = acceptableContentTypes[j];\n                 formatterContext.ContentType = new StringSegment(contentType);\n                 formatterContext.ContentTypeIsServerDefined = true;\n "}
{"filename":"src/Mvc/Mvc.Core/test/Formatters/AcceptHeaderParserTest.cs","patch":"@@ -119,6 +119,34 @@ public void ParseAcceptHeader_ParsesMultipleHeaderValues()\n         Assert.Equal(expected, parsed);\n     }\n \n+    [Fact]\n+    public void ParseAcceptHeader_StringValues_ParsesMultipleHeaderValues()\n+    {\n+        var expected = new List\u003cMediaTypeSegmentWithQuality\u003e\n+            {\n+                new MediaTypeSegmentWithQuality(new StringSegment(\"application/json\"), 1.0),\n+                new MediaTypeSegmentWithQuality(new StringSegment(\"text/plain;q=0.9\"), 0.9),\n+                new MediaTypeSegmentWithQuality(new StringSegment(\"application/xml;q=0.8\"), 0.8)\n+            };\n+        var parsed = new List\u003cMediaTypeSegmentWithQuality\u003e();\n+\n+        AcceptHeaderParser.ParseAcceptHeader(\n+            new StringValues(new[] { \"application/json, text/plain;q=0.9\", \"\", null, \"application/xml;q=0.8\" }),\n+            parsed);\n+\n+        Assert.Equal(expected, parsed);\n+    }\n+\n+    [Fact]\n+    public void ParseAcceptHeader_StringValues_Empty_ParsesNothing()\n+    {\n+        var parsed = new List\u003cMediaTypeSegmentWithQuality\u003e();\n+\n+        AcceptHeaderParser.ParseAcceptHeader(StringValues.Empty, parsed);\n+\n+        Assert.Empty(parsed);\n+    }\n+\n     // The text \"*/*Content-Type\" parses as a valid media type value. However it's followed\n     // by ':' instead of whitespace or a delimiter, which means that it's actually invalid.\n     [Fact]"}
{"filename":"src/Mvc/Mvc.Core/test/Infrastructure/DefaultOutputFormatterSelectorTest.cs","patch":"@@ -295,6 +295,61 @@ public void SelectFormatter_WithAcceptHeaderOnly_SetsContentTypeIsServerDefinedT\n         Assert.Null(formatter);\n     }\n \n+    [Fact]\n+    public void SelectFormatter_WithMultipleAcceptHeaderValues_SelectsHighestQualityAcrossValues()\n+    {\n+        var formatters = new List\u003cIOutputFormatter\u003e\n+            {\n+                new TestXmlOutputFormatter(),\n+                new TestJsonOutputFormatter(),\n+            };\n+        var selector = CreateSelector(formatters);\n+\n+        var context = new OutputFormatterWriteContext(\n+            new DefaultHttpContext(),\n+            new TestHttpResponseStreamWriterFactory().CreateWriter,\n+            objectType: null,\n+            @object: null);\n+\n+        context.HttpContext.Request.Headers.Accept = new StringValues(new[] { \"application/xml;q=0.5\", \"\", \"text/plain, application/json\" });\n+\n+        var formatter = selector.SelectFormatter(\n+            context,\n+            Array.Empty\u003cIOutputFormatter\u003e(),\n+            new MediaTypeCollection());\n+\n+        Assert.Same(formatters[1], formatter);\n+        Assert.Equal(new StringSegment(\"application/json\"), context.ContentType);\n+    }\n+\n+    [Fact]\n+    public void SelectFormatter_WithEmptyAcceptHeaderValue_ChoosesFirstFormatterThatCanWrite()\n+    {\n+        var formatters = new List\u003cIOutputFormatter\u003e\n+            {\n+                new CannotWriteFormatter(),\n+                new TestJsonOutputFormatter(),\n+                new TestXmlOutputFormatter(),\n+            };\n+        var selector = CreateSelector(formatters);\n+\n+        var context = new OutputFormatterWriteContext(\n+            new DefaultHttpContext(),\n+            new TestHttpResponseStreamWriterFactory().CreateWriter,\n+            objectType: null,\n+            @object: null);\n+\n+        context.HttpContext.Request.Headers.Accept = \"\";\n+\n+        var formatter = selector.SelectFormatter(\n+            context,\n+            Array.Empty\u003cIOutputFormatter\u003e(),\n+            new MediaTypeCollection());\n+\n+        Assert.Same(formatters[1], formatter);\n+        Assert.Equal(new StringSegment(\"application/json\"), context.ContentType);\n+    }\n+\n     [Fact]\n     public void SelectFormatter_WithAcceptHeaderAndContentTypes_SetsContentTypeIsServerDefinedWhenExpected()\n     {"}
