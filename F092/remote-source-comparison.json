3a1c3d56f11615bdb1296c5"}]}],"files":[{"sha":"b565ef9bd5e2616452bb8cdd829f72ae368ae49b","filename":"src/Hosting/TestHost/src/ResponseBodyReaderStream.cs","status":"modified","additions":2,"deletions":1,"changes":3,"blob_url":"https://github.com/jaslawinMs/aspnetcore/blob/32145f885b99cacd7f86dafa9bd92422f87c0e15/src%2FHosting%2FTestHost%2Fsrc%2FResponseBodyReaderStream.cs","raw_url":"https://github.com/jaslawinMs/aspnetcore/raw/32145f885b99cacd7f86dafa9bd92422f87c0e15/src%2FHosting%2FTestHost%2Fsrc%2FResponseBodyReaderStream.cs","contents_url":"https://api.github.com/repos/jaslawinMs/aspnetcore/contents/src%2FHosting%2FTestHost%2Fsrc%2FResponseBodyReaderStream.cs?ref=32145f885b99cacd7f86dafa9bd92422f87c0e15","patch":"@@ -66,7 +66,8 @@ public override void Flush()\n \n     public override int Read(byte[] buffer, int offset, int count)\n     {\n-        return ReadAsync(buffer, offset, count, CancellationToken.None).GetAwaiter().GetResult();\n+        var readTask = ReadAsync(buffer.AsMemory(offset, count), CancellationToken.None);\n+        return readTask.IsCompletedSuccessfully ? readTask.Result : readTask.AsTask().GetAwaiter().GetResult();\n     }\n \n     public override Task<int> ReadAsync(byte[] buffer, int offset, int count, CancellationToken cancellationToken)"},{"sha":"d4714e736b2b1185b7cf48a04b7641d6440a51c0","filename":"src/Hosting/TestHost/test/ResponseBodyTests.cs","status":"modified","additions":27,"deletions":0,"changes":27,"blob_url":"https://github.com/jaslawinMs/aspnetcore/blob/32145f885b99cacd7f86dafa9bd92422f87c0e15/src%2FHosting%2FTestHost%2Ftest%2FResponseBodyTests.cs","raw_url":"https://github.com/jaslawinMs/aspnetcore/raw/32145f885b99cacd7f86dafa9bd92422f87c0e15/src%2FHosting%2FTestHost%2Ftest%2FResponseBodyTests.cs","contents_url":"https://api.github.com/repos/jaslawinMs/aspnetcore/contents/src%2FHosting%2FTestHost%2Ftest%2FResponseBodyTests.cs?ref=32145f885b99cacd7f86dafa9bd92422f87c0e15","patch":"@@ -154,6 +154,33 @@ public async Task BodyStream_ZeroByteRead_Success()\n         Assert.Equal(contentBytes[0], bytes[0]);\n     }\n \n+    [Theory]\n+    [InlineData(8)]\n+    [InlineData(9)]\n+    [InlineData(256)]\n+    public async Task BodyStream_SynchronousRead_PreservesOffsetShortReadAndEof(int byteCount)\n+    {\n+        var contentBytes = Enumerable.Range(0, byteCount).Select(i => (byte)(i % 239)).ToArray();\n+        var contentFlushed = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);\n+        using var host = await CreateHost(async httpContext =>\n+        {\n+            await httpContext.Response.BodyWriter.WriteAsync(contentBytes);\n+            contentFlushed.SetResult();\n+        });\n+\n+        using var client = host.GetTestServer().CreateClient();\n+        using var response = await client.GetAsync(\"/\", HttpCompletionOption.ResponseHeadersRead);\n+        var stream = await response.Content.ReadAsStreamAsync();\n+        await contentFlushed.Task.DefaultTimeout();\n+        var bytes = Enumerable.Repeat((byte)255, byteCount + 4).ToArray();\n+\n+        Assert.Equal(byteCount, stream.Read(bytes, 2, byteCount + 1));\n+        Assert.Equal(contentBytes, bytes[2..(byteCount + 2)]);\n+        Assert.All(bytes[..2], value => Assert.Equal((byte)255, value));\n+        Assert.All(bytes[(byteCount + 2)..], value => Assert.Equal((byte)255, value));\n+        Assert.Equal(0, stream.Read(bytes, 2, byteCount));\n+    }\n+\n     private Task<IHost> CreateHost(RequestDelegate appDelegate)\n     {\n         return new HostBuilder()"}]}
