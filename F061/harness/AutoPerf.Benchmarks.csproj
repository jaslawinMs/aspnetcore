<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net12.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RuntimeFrameworkVersion>12.0.0-alpha.1.26562.105</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <AspNetCoreRoot Condition="'$(AspNetCoreRoot)' == ''">C:\src\aspnetcore</AspNetCoreRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.13.0" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Security\Authentication\Cookies\src\Microsoft.AspNetCore.Authentication.Cookies.csproj" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Http\Http\src\Microsoft.AspNetCore.Http.csproj" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Http\Http.Abstractions\src\Microsoft.AspNetCore.Http.Abstractions.csproj" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Http\Http.Features\src\Microsoft.AspNetCore.Http.Features.csproj" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Http\Headers\src\Microsoft.Net.Http.Headers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(AspNetCoreRoot)\artifacts\bin\Microsoft.AspNetCore.CookiePolicy.Test\Release\net12.0\Microsoft.AspNetCore.*.dll"
               Exclude="$(AspNetCoreRoot)\artifacts\bin\Microsoft.AspNetCore.CookiePolicy.Test\Release\net12.0\*Test*.dll;$(AspNetCoreRoot)\artifacts\bin\Microsoft.AspNetCore.CookiePolicy.Test\Release\net12.0\Microsoft.AspNetCore.Authentication.Cookies.dll" />
  </ItemGroup>
  <Target Name="ValidateTestedDependencies" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(AspNetCoreRoot)\artifacts\bin\Microsoft.AspNetCore.CookiePolicy.Test\Release\net12.0\Microsoft.AspNetCore.Authentication.Cookies.dll')"
           Text="Build and run CookieChunkingTests in Microsoft.AspNetCore.CookiePolicy.Test Release first; use its current-repo shipping dependencies, not the installed ASP.NET framework." />
  </Target>
</Project>
