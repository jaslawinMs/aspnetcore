d","locked":false,"assignees":[],"milestone":{"url":"https://api.github.com/repos/dotnet/aspnetcore/milestones/105","html_url":"https://github.com/dotnet/aspnetcore/milestone/105","labels_url":"https://api.github.com/repos/dotnet/aspnetcore/milestones/105/labels","id":5318147,"node_id":"MDk6TWlsZXN0b25lNTMxODE0Nw==","number":105,"title":"3.1.5","description":"","creator":{"login":"dougbu","id":6431421,"node_id":"MDQ6VXNlcjY0MzE0MjE=","avatar_url":"https://avatars.githubusercontent.com/u/6431421?v=4","gravatar_id":"","url":"https://api.github.com/users/dougbu","html_url":"https://github.com/dougbu","followers_url":"https://api.github.com/users/dougbu/followers","following_url":"https://api.github.com/users/dougbu/following{/other_user}","gists_url":"https://api.github.com/users/dougbu/gists{/gist_id}","starred_url":"https://api.github.com/users/dougbu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dougbu/subscriptions","organizations_url":"https://api.github.com/users/dougbu/orgs","repos_url":"https://api.github.com/users/dougbu/repos","events_url":"https://api.github.com/users/dougbu/events{/privacy}","received_events_url":"https://api.github.com/users/dougbu/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":12,"state":"closed","created_at":"2020-04-16T22:27:39Z","updated_at":"2020-06-10T14:03:56Z","due_on":"2020-06-09T00:00:00Z","closed_at":"2020-06-10T14:03:56Z"},"comments":10,"created_at":"2020-05-13T22:11:59Z","updated_at":"2020-05-14T23:34:11Z","closed_at":"2020-05-14T23:34:10Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/dotnet/aspnetcore/pulls/21801","html_url":"https://github.com/dotnet/aspnetcore/pull/21801","diff_url":"https://github.com/dotnet/aspnetcore/pull/21801.diff","patch_url":"https://github.com/dotnet/aspnetcore/pull/21801.patch","merged_at":"2020-05-14T23:34:10Z"},"body":"Customers have reported issues with our .MSI's when repairing VS. We believe the issue is due to the ProductCode/ProductVersion of the installers not being unique per build, but instead being unique per package version. Giving the MSI's suffixed versions should fix the issue\r\n\r\nCC @Pilchie @joeloff ","reactions":{"url":"https://api.github.com/repos/dotnet/aspnetcore/issues/21801/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/dotnet/aspnetcore/issues/21801/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0}],"search_type":"lexical"}