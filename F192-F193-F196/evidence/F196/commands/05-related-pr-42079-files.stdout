[{"sha":"0fe3631e569508a9a281ca905948491650a1d13f","filename":"src/ProjectTemplates/Shared/Project.cs","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/dotnet/aspnetcore/blob/415faa7be797484540cefbdbb56e16c887808dd0/src%2FProjectTemplates%2FShared%2FProject.cs","raw_url":"https://github.com/dotnet/aspnetcore/raw/415faa7be797484540cefbdbb56e16c887808dd0/src%2FProjectTemplates%2FShared%2FProject.cs","contents_url":"https://api.github.com/repos/dotnet/aspnetcore/contents/src%2FProjectTemplates%2FShared%2FProject.cs?ref=415faa7be797484540cefbdbb56e16c887808dd0","patch":"@@ -466,7 +466,7 @@ private void CaptureBinLogOnFailure(ProcessEx result)\n         if (result.ExitCode != 0 && !string.IsNullOrEmpty(ArtifactsLogDir))\n         {\n             var sourceFile = Path.Combine(TemplateOutputDir, \"msbuild.binlog\");\n-            Assert.True(File.Exists(sourceFile), $\"Log for '{ProjectName}' not found in '{sourceFile}'.\");\n+            Assert.True(File.Exists(sourceFile), $\"Log for '{ProjectName}' not found in '{sourceFile}'. Execution output: {result.Output}\");\n             var destination = Path.Combine(ArtifactsLogDir, ProjectName + \".binlog\");\n             File.Move(sourceFile, destination, overwrite: true); // binlog will exist on retries\n         }"},{"sha":"d3a39c650379b9ec14169922d1f6e01bd9b9048f","filename":"src/ProjectTemplates/Web.ProjectTemplates/EmptyBlazorServerWeb-CSharp.csproj.in","status":"added","additions":11,"deletions":0,"changes":11,"blob_url":"https://github.com/dotnet/aspnetcore/blob/415faa7be797484540cefbdbb56e16c887808dd0/src%2FProjectTemplates%2FWeb.ProjectTemplates%2FEmptyBlazorServerWeb-CSharp.csproj.in","raw_url":"https://github.com/dotnet/aspnetcore/raw/415faa7be797484540cefbdbb56e16c887808dd0/src%2FProjectTemplates%2FWeb.ProjectTemplates%2FEmptyBlazorServerWeb-CSharp.csproj.in","contents_url":"https://api.github.com/repos/dotnet/aspnetcore/contents/src%2FProjectTemplates%2FWeb.ProjectTemplates%2FEmptyBlazorServerWeb-CSharp.csproj.in?ref=415faa7be797484540cefbdbb56e16c887808dd0","patch":"@@ -0,0 +1,11 @@\n+<Project Sdk=\"Microsoft.NET.Sdk.Web\">\n+\n+  <PropertyGroup>\n+    <TargetFramework>${DefaultNetCoreTargetFramework}</TargetFramework>\n+    <Nullable>enable</Nullable>\n+    <ImplicitUsings>enable</ImplicitUsings>\n+    <NoDefaultLaunchSettingsFile Condition=\"'$(ExcludeLaunchSettings)' == 'True'\">True</NoDefaultLaunchSettingsFile>\n+    <RootNamespace Condition=\"'$(name)' != '$(name{-VALUE-FORMS-}safe_namespace)'\">EmptyBlazorServerWeb_CSharp</RootNamespace>\n+  </PropertyGroup>\n+\n+</Project>"},{"sha":"ceae5ca947201104d03492e86de3739996cd580d","filename":"src/ProjectTemplates/Web.ProjectTemplates/Microsoft.DotNet.Web.ProjectTemplates.csproj","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/dotnet/aspnetcore/blob/415faa7be797484540cefbdbb56e16c887808dd0/src%2FProjectTemplates%2FWeb.ProjectTemplates%2FMicrosoft.DotNet.Web.ProjectTemplates.csproj","raw_url":"https://github.com/dotnet/aspnetcore/raw/415faa7be797484540cefbdbb56e16c887808dd0/src%2FProjectTemplates%2FWeb.ProjectTemplates%2FMicrosoft.DotNet.Web.ProjectTemplates.csproj","contents_url":"https://api.github.com/repos/dotnet/aspnetcore/contents/src%2FProjectTemplates%2FWeb.ProjectTemplates%2FMicrosoft.DotNet.Web.ProjectTemplates.csproj?ref=415faa7be797484540cefbdbb56e16c887808dd0","patch":"@@ -56,6 +56,7 @@\n     <GeneratedContent Include=\"EmptyWeb-FSharp.fsproj.in\" OutputPath=\"content/EmptyWeb-FSharp/Company.WebApplication1.fsproj\" />\n     <GeneratedContent Include=\"GrpcService-CSharp.csproj.in\" OutputPath=\"content/GrpcService-CSharp/GrpcService-CSharp.csproj\" />\n     <GeneratedContent Include=\"BlazorServerWeb-CSharp.csproj.in\" OutputPath=\"content/BlazorServerWeb-CSharp/BlazorServerWeb-CSharp.csproj\" />\n+    <GeneratedContent Include=\"EmptyBlazorServerWeb-CSharp.csproj.in\" OutputPath=\"content/EmptyBlazorServerWeb-CSharp/EmptyBlazorServerWeb-CSharp.csproj\" />\n     <GeneratedContent Include=\"RazorPagesWeb-CSharp.csproj.in\" OutputPath=\"content/RazorPagesWeb-CSharp/Company.WebApplication1.csproj\" />\n     <GeneratedContent Include=\"RazorClassLibrary-CSharp.csproj.in\" OutputPath=\"content/RazorClassLibrary-CSharp/Company.RazorClassLibrary1.csproj\" />\n     <GeneratedContent Include=\"StarterWeb-CSharp.csproj.in\" OutputPath=\"content/StarterWeb-CSharp/Company.WebApplication1.csproj\" />"},{"sha":"d97858472b807514d1a7c5705d1fb5634f691673","filename":"src/ProjectTemplates/Web.ProjectTemplates/content/EmptyBlazorServerWeb-CSharp/.template.config/dotnetcli.host.json","status":"added","additions":35,"deletions":0,"changes":35,"blob_url":"https://github.com/dotnet/aspnetcore/blob/415faa7be797484540cefbdbb56e16c887808dd0/src%2FProjectTemplates%2FWeb.ProjectTemplates%2Fcontent%2FEmptyBlazorServerWeb-CSharp%2F.template.config%2Fdotnetcli.host.json","raw_url":"https://github.com/dotnet/aspnetcore/raw/415faa7be797484540cefbdbb56e16c887808dd0/src%2FProjectTemplates%2FWeb.ProjectTemplates%2Fcontent%2FEmptyBlazorServerWeb-CSharp%2F.template.config%2Fdotnetcli.host.json","contents_url":"https://api.github.com/repos/dotnet/aspnetcore/contents/src%2FProjectTemplates%2FWeb.ProjectTemplates%2Fcontent%2FEmptyBlazorServerWeb-CSharp%2F.template.config%2Fdotnetcli.host.json?ref=415faa7be797484540cefbdbb56e16c887808dd0","patch":"@@ -0,0 +1,35 @@\n+{\n+  \"$schema\": \"http://json.schemastore.org/dotnetcli.host\",\n+  \"symbolInfo\": {\n+    \"Framework\": {\n+      \"longName\": \"framework\"\n+    },\n+    \"skipRestore\": {\n+      \"longName\": \"no-restore\",\n+      \"shortName\": \"\"\n+    },\n+    \"kestrelHttpPort\": {\n+      \"isHidden\": true\n+    },\n+    \"kestrelHttpsPort\": {\n+      \"isHidden\": true\n+    },\n+    \"iisHttpPort\": {\n+      \"isHidden\": true\n+    },\n+    \"iisHttpsPort\": {\n+      \"isHidden\": true\n+    },\n+    \"ExcludeLaunchSettings\": {\n+      \"longName\": \"exclude-launch-settings\",\n+      \"shortName\": \"\"\n+    },\n+    \"NoHttps\": {\n+      \"longName\": \"no-https\",\n+      \"shortName\": \"\"\n+    }\n+  },\n+  \"usageExamples\": [\n+    \"\"\n+  ]\n+}"},{"sha":"278a9a31ca519fe0a79d36c87ffb2825e2e64bdb","filename":"src/ProjectTemplates/Web.ProjectTemplates/content/EmptyBlazorServerWeb-CSharp/.template.config/ide.host.json","status":"added","additions":18,"deletions":0,"changes":18,"blob_url":"https://github.com/dotnet/aspnetcore/blob/415faa7be797484540cefbdbb56e16c887808dd0/src%2FProjectTemplates%2FWeb.ProjectTemplates%2Fcontent%2FEmptyBlazorServerWeb-CSharp%2F.template.config%2Fide.host.json","raw_url":"https://github.com/dotnet/aspnetcore/raw/415faa7be797484540cefbdbb56e16c887808dd0/src%2FProjectTemplates%2FWeb.ProjectTemplates%2Fcontent%2FEmptyBlazorServerWeb-CSharp%2F.template.config%2Fide.host.json","contents_url":"https://api.github.com/repos/dotnet/aspnetcore/contents/src%2FProjectTemplates%2FWeb.ProjectTemplates%2Fcontent%2FEmptyBlazorServerWeb-CSharp%2F.template.config%2Fide.host.json?ref=415faa7be797484540cefbdbb56e16c887808dd0","patch":"@@ -0,0 +1,18 @@\n+{\n+  \"$schema\": \"http://json.schemastore.org/ide.host\",\n+  \"order\": 650,\n+  \"icon\": \"ide/icon.png\",\n+  \"disableHttpsSymbol\": \"NoHttps\",\n+  \"supportsDocker\": true,\n+  \"tags\": [\n+    {\n+      \"type\": \"projectType\",\n+      \"add\": [ \"Cloud\", \"Web\" ],\n+      \"remove\": [ \"*\" ]\n+    },\n+    {\n+      \"type\": \"platform\",\n+      \"add\": [ \"Linux\", \"macOS\", \"Windows\" ]\n+    }\n+  ]\n+}"},{"sha":"8422b59695935d180d11d5dbe99653e711097819","filename":"src/ProjectTemplates/Web.ProjectTemplates/content/EmptyBlazorServerWeb-CSharp/.template.config/ide/icon.png","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/dotnet/aspnetcore/blob/415faa7be797484540cefbdbb56e16c887808dd0/src%2FProjectTemplates%2FWeb.ProjectTemplates%2Fcontent%2FEmptyBlazorServerWeb-CSharp%2F.template.c