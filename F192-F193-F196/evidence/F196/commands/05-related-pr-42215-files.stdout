[{"sha":"4b413350265bb687a3e5c480dfb1151e29265f43","filename":"src/ProjectTemplates/Web.ProjectTemplates/EmptyComponentsWebAssembly-CSharp.Client.csproj.in","status":"added","additions":33,"deletions":0,"changes":33,"blob_url":"https://github.com/dotnet/aspnetcore/blob/4a1a6d962aaa1dd3698d6d09bf31ee32ada21b52/src%2FProjectTemplates%2FWeb.ProjectTemplates%2FEmptyComponentsWebAssembly-CSharp.Client.csproj.in","raw_url":"https://github.com/dotnet/aspnetcore/raw/4a1a6d962aaa1dd3698d6d09bf31ee32ada21b52/src%2FProjectTemplates%2FWeb.ProjectTemplates%2FEmptyComponentsWebAssembly-CSharp.Client.csproj.in","contents_url":"https://api.github.com/repos/dotnet/aspnetcore/contents/src%2FProjectTemplates%2FWeb.ProjectTemplates%2FEmptyComponentsWebAssembly-CSharp.Client.csproj.in?ref=4a1a6d962aaa1dd3698d6d09bf31ee32ada21b52","patch":"@@ -0,0 +1,33 @@\n+<Project Sdk=\"Microsoft.NET.Sdk.BlazorWebAssembly\">\n+\n+  <PropertyGroup>\n+    <TargetFramework>${DefaultNetCoreTargetFramework}</TargetFramework>\n+    <Nullable>enable</Nullable>\n+    <ImplicitUsings>enable</ImplicitUsings>\n+    <!--#if PWA -->\n+    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>\n+    <!--#endif -->\n+    <!--#if Hosted -->\n+    <AssemblyName Condition=\"'$(name)' != '$(name{-VALUE-FORMS-}safe_namespace)'\">`$(AssemblyName.Replace(' ', '_'))</AssemblyName>\n+    <!--#endif -->\n+  </PropertyGroup>\n+\n+  <ItemGroup>\n+    <PackageReference Include=\"Microsoft.AspNetCore.Components.WebAssembly\" Version=\"${MicrosoftAspNetCoreComponentsWebAssemblyVersion}\" />\n+    <PackageReference Include=\"Microsoft.AspNetCore.Components.WebAssembly.DevServer\" Version=\"${MicrosoftAspNetCoreComponentsWebAssemblyDevServerVersion}\" PrivateAssets=\"all\" />\n+    <PackageReference Include=\"Microsoft.Extensions.Http\" Version=\"${MicrosoftExtensionsHttpVersion}\" Condition=\"'$(Hosted)' == 'true'\" />\n+  </ItemGroup>\n+\n+  <!--#if Hosted -->\n+  <ItemGroup>\n+    <ProjectReference Include=\"..\\Shared\\EmptyComponentsWebAssembly-CSharp.Shared.csproj\" />\n+  </ItemGroup>\n+\n+  <!--#endif -->\n+  <!--#if PWA -->\n+  <ItemGroup>\n+    <ServiceWorker Include=\"wwwroot\\service-worker.js\" PublishedContent=\"wwwroot\\service-worker.published.js\" />\n+  </ItemGroup>\n+\n+  <!--#endif -->\n+</Project>"},{"sha":"f54a03b7f4884b84dfd7942b73c23616a8d67e46","filename":"src/ProjectTemplates/Web.ProjectTemplates/EmptyComponentsWebAssembly-CSharp.Server.csproj.in","status":"added","additions":21,"deletions":0,"changes":21,"blob_url":"https://github.com/dotnet/aspnetcore/blob/4a1a6d962aaa1dd3698d6d09bf31ee32ada21b52/src%2FProjectTemplates%2FWeb.ProjectTemplates%2FEmptyComponentsWebAssembly-CSharp.Server.csproj.in","raw_url":"https://github.com/dotnet/aspnetcore/raw/4a1a6d962aaa1dd3698d6d09bf31ee32ada21b52/src%2FProjectTemplates%2FWeb.ProjectTemplates%2FEmptyComponentsWebAssembly-CSharp.Server.csproj.in","contents_url":"https://api.github.com/repos/dotnet/aspnetcore/contents/src%2FProjectTemplates%2FWeb.ProjectTemplates%2FEmptyComponentsWebAssembly-CSharp.Server.csproj.in?ref=4a1a6d962aaa1dd3698d6d09bf31ee32ada21b52","patch":"@@ -0,0 +1,21 @@\n+<Project Sdk=\"Microsoft.NET.Sdk.Web\">\n+\n+  <PropertyGroup>\n+    <TargetFramework>${DefaultNetCoreTargetFramework}</TargetFramework>\n+    <Nullable>enable</Nullable>\n+    <ImplicitUsings>enable</ImplicitUsings>\n+    <NoDefaultLaunchSettingsFile Condition=\"'$(ExcludeLaunchSettings)' == 'True'\">True</NoDefaultLaunchSettingsFile>\n+    <RootNamespace Condition=\"'$(name)' != '$(name{-VALUE-FORMS-}safe_namespace)'\">EmptyComponentsWebAssembly-CSharp.Server</RootNamespace>\n+    <AssemblyName Condition=\"'$(name)' != '$(name{-VALUE-FORMS-}safe_namespace)'\">`$(AssemblyName.Replace(' ', '_'))</AssemblyName>\n+  </PropertyGroup>\n+\n+  <ItemGroup>\n+    <PackageReference Include=\"Microsoft.AspNetCore.Components.WebAssembly.Server\" Version=\"${MicrosoftAspNetCoreComponentsWebAssemblyServerVersion}\" />\n+  </ItemGroup>\n+\n+  <ItemGroup>\n+    <ProjectReference Include=\"..\\Client\\EmptyComponentsWebAssembly-CSharp.Client.csproj\" />\n+    <ProjectReference Include=\"..\\Shared\\EmptyComponentsWebAssembly-CSharp.Shared.csproj\" />\n+  </ItemGroup>\n+\n+</Project>"},{"sha":"ba1c0026e997e19801e028c6b4dc407ad9765f6e","filename":"src/ProjectTemplates/Web.ProjectTemplates/EmptyComponentsWebAssembly-CSharp.Shared.csproj.in","status":"added","additions":12,"deletions":0,"changes":12,"blob_url":"https://github.com/dotnet/aspnetcore/blob/4a1a6d962aaa1dd3698d6d09bf31ee32ada21b52/src%2FProjectTemplates%2FWeb.ProjectTemplates%2FEmptyComponentsWebAssembly-CSharp.Shared.csproj.in","raw_url":"https://github.com/dotnet/aspnetcore/raw/4a1a6d962aaa1dd3698d6d09bf31ee32ada21b52/src%2FProjectTemplates%2FWeb.ProjectTemplates%2FEmptyComponentsWebAssembly-CSharp.Shared.csproj.in","contents_url":"https://api.github.com/repos/dotnet/aspnetcore/contents/src%2FProjectTemplates%2FWeb.ProjectTemplates%2FEmptyComponentsWebAssembly-CSharp.Shared.csproj.in?ref=4a1a6d962aaa1dd3698d6d09bf31ee32ada21b52","patch":"@@ -0,0 +1,12 @@\n+<Project Sdk=\"Microsoft.NET.Sdk\">\n+\n+  <PropertyGroup>\n+    <TargetFramework>${DefaultNetCoreTargetFramework}</TargetFramework>\n+    <Nullable>enable</Nullable>\n+    <ImplicitUsings>enable</ImplicitUsings>\n+  </PropertyGroup>\n+\n+  <ItemGroup>\n+    <SupportedPlatform Include=\"browser\" />\n+  </ItemGroup>\n+</Project>"},{"sha":"80e8cb93d7596d25d8e7e915d7e37e592f0db10c","filename":"src/ProjectTemplates/Web.ProjectTemplates/Microsoft.DotNet.Web.ProjectTemplates.csproj","status":"modified","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/dotnet/aspnetcore/blob/4a1a6d962aaa1dd3698d6d09bf31ee32ada21b52/src%2FProjectTemplates%2FWeb.ProjectTemplates%2FMicrosoft.DotNet.Web.ProjectTemplates.csproj","raw_url":"https://github.com/dotnet/aspnetcore/raw/4a1a6d962aaa1dd3698d6d09bf31ee32ada21b52/src%2FProjectTemplates%2FWeb.ProjectTemplates%2FMicrosoft.DotNet.Web.P