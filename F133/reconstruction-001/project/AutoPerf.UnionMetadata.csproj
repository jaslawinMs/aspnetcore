<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net12.0</TargetFramework>
    <RuntimeFrameworkVersion>12.0.0-alpha.1.26562.105</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ReferencePathRoot Condition="'$(ReferencePathRoot)' == ''">C:\src\aspnetcore\artifacts\bin\Microsoft.AspNetCore.Mvc.IntegrationTests\Release\net12.0</ReferencePathRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Reference Include="$(ReferencePathRoot)\Microsoft.AspNetCore.*.dll"
               Exclude="$(ReferencePathRoot)\*.Tests.dll;$(ReferencePathRoot)\*.TestCommon.dll;$(ReferencePathRoot)\*.Test.dll" />
    <Reference Include="$(ReferencePathRoot)\Microsoft.Extensions.*.dll" />
    <Reference Include="$(ReferencePathRoot)\Microsoft.Net.Http.Headers.dll" />
  </ItemGroup>
</Project>
