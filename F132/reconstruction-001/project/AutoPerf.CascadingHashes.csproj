<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net12.0</TargetFramework>
    <RuntimeFrameworkVersion>12.0.0-alpha.1.26562.105</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ReferencePathRoot Condition="'$(ReferencePathRoot)' == ''">C:\src\aspnetcore\artifacts\bin\Microsoft.AspNetCore.Components.Media.Tests\Release\net12.0</ReferencePathRoot>
    <ComponentsOwnerRoot Condition="'$(ComponentsOwnerRoot)' == ''">C:\src\aspnetcore\artifacts\bin\Microsoft.AspNetCore.Components.Tests\Release\net12.0</ComponentsOwnerRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Reference Include="Microsoft.AspNetCore.Components" HintPath="$(ComponentsOwnerRoot)\Microsoft.AspNetCore.Components.dll" />
    <Reference Include="Microsoft.AspNetCore.Components.Web" HintPath="$(ReferencePathRoot)\Microsoft.AspNetCore.Components.Web.dll" />
    <Reference Include="Microsoft.JSInterop" HintPath="$(ReferencePathRoot)\Microsoft.JSInterop.dll" />
    <Reference Include="Microsoft.Extensions.DependencyInjection" HintPath="$(ReferencePathRoot)\Microsoft.Extensions.DependencyInjection.dll" />
    <Reference Include="Microsoft.Extensions.Logging" HintPath="$(ReferencePathRoot)\Microsoft.Extensions.Logging.dll" />
  </ItemGroup>
</Project>
