[xUnit.net 00:01:25.22]                   const suppressEnhancedNavigation = sessionStorage.getItem('suppress-enhanced-navigation') === 'true';&#xD;
[xUnit.net 00:01:25.22]                   const blockLoadBootResource = sessionStorage.getItem('block-load-boot-resource') === 'true';&#xD;
[xUnit.net 00:01:25.22]                   const blockWebassemblySettings = getQueryParam('block-webassembly-settings') === 'true';&#xD;
[xUnit.net 00:01:25.22]                   const keepCircuitAlive = sessionStorage.getItem('keep-circuit-alive') === 'true';&#xD;
[xUnit.net 00:01:25.22]                   sessionStorage.removeItem('block-load-boot-resource');&#xD;
[xUnit.net 00:01:25.22]                   sessionStorage.removeItem('enable-classic-initializers');&#xD;
[xUnit.net 00:01:25.22]       &#xD;
[xUnit.net 00:01:25.22]                   let loadBootResourceUnblocked = null;&#xD;
[xUnit.net 00:01:25.22]                   if (blockLoadBootResource) {&#xD;
[xUnit.net 00:01:25.22]                       loadBootResourceUnblocked = new Promise(resolve =&gt; {&#xD;
[xUnit.net 00:01:25.22]                           window.unblockLoadBootResource = () =&gt; {&#xD;
[xUnit.net 00:01:25.22]                               var origSetItem = localStorage.setItem;&#xD;
