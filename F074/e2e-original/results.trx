[xUnit.net 00:01:25.22]                                           window['__aspnetcore__testing__max__parallel__resource__download__count'] = maxParallelResourceDownloadCount;&#xD;
[xUnit.net 00:01:25.22]                                       }&#xD;
[xUnit.net 00:01:25.22]                                       currentParallelResourceDownloadCount--;&#xD;
