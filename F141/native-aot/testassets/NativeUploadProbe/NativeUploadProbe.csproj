<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net12.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>AutoPerf.SignalR.NativeUploadProbe</AssemblyName>
    <LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <RuntimeFrameworkVersion>12.0.0-alpha.1.26557.102</RuntimeFrameworkVersion>
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="Microsoft.AspNetCore.SignalR.Client.Core" HintPath="..\owner-inputs\Microsoft.AspNetCore.SignalR.Client.Core.dll" Private="true" />
    <Reference Include="Microsoft.AspNetCore.SignalR.Common" HintPath="..\owner-inputs\Microsoft.AspNetCore.SignalR.Common.dll" Private="true" />
    <Reference Include="Microsoft.AspNetCore.SignalR.Protocols.Json" HintPath="..\owner-inputs\Microsoft.AspNetCore.SignalR.Protocols.Json.dll" Private="true" />
  </ItemGroup>
</Project>
