                 ? typeof(TemplatePackageInstaller)
                     .Assembly.GetCustomAttributes<AssemblyMetadataAttribute>()
                     .Single(s => s.Key == "CustomTemplateHivePath").Value
                 : Path.Combine("Hives", ".templateEngine"));

