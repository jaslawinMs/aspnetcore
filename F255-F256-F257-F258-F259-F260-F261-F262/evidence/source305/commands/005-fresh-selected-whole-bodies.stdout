        {
            get
            {
                if ((_bits & 0x2L) != 0)
                {
                    return _headers._Connection;
                }
                return StringValues.Empty;
            }
            set
            {
                if (!StringValues.IsNullOrEmpty(value))
                {
                    _bits |= 0x2L;
                    _headers._Connection = value; 
                }
                else
                {
                    _bits &= ~0x2L;
                    _headers._Connection = default; 
                }
            }
