    {
        ArgumentNullException.ThrowIfNull(configure);

        var listenOptions = new ListenOptions(handle);
        ApplyEndpointDefaults(listenOptions);
        configure(listenOptions);
        CodeBackedListenOptions.Add(listenOptions);
    }

    /// <summary>
