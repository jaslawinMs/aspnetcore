    }

    [Fact]
    public async Task RegisterAddresses_IPv4LocalhostStaticPort_Success()
    {
        await RegisterAddresses_StaticPort_Success("http://localhost", "http://127.0.0.1");
    }

    [Fact]
    public async Task RegisterIPEndPoint_IPv4StaticPort_Success()
