        var endpoint = reader.Endpoints.First();
#pragma warning disable SYSLIB0039 // TLS 1.0 and 1.1 are obsolete
        Assert.Equal(SslProtocols.Tls11, endpoint.SslProtocols);
#pragma warning restore SYSLIB0039
