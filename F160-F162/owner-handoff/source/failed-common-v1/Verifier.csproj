<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net12.0</TargetFramework>
    <RuntimeFrameworkVersion>12.0.0-alpha.1.26562.105</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseSharedCompilation>false</UseSharedCompilation>
    <NativeOutput>$(MSBuildThisFileDirectory)..\original\artifacts\bin\Microsoft.AspNetCore.Components.AI.SourceGenerators.Tests\Release\net12.0</NativeOutput>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(NativeOutput)\*.dll" />
  </ItemGroup>
</Project>
