<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net12.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeFrameworkVersion>12.0.0-alpha.1.26562.105</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <OriginalBin>$(MSBuildThisFileDirectory)..\binaries\before</OriginalBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(OriginalBin)\Microsoft.*.dll"
      Exclude="$(OriginalBin)\*Test*.dll;$(OriginalBin)\*Generator*.dll" Private="true" />
  </ItemGroup>
</Project>
