<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net12.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeFrameworkVersion>12.0.0-alpha.1.26562.105</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="..\binaries\after-2\Microsoft.*.dll"
      Exclude="..\binaries\after-2\*Generator*.dll;..\binaries\after-2\Microsoft.CodeAnalysis*.dll"
      Private="true" />
  </ItemGroup>
</Project>
