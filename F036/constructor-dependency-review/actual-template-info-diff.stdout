     }
 
     /// <summary>
@@ -32,7 +32,10 @@ public class TemplateInfo
     {
         FormattedModelValue = original.FormattedModelValue;
         HtmlFieldPrefix = original.HtmlFieldPrefix;
-        _visitedObjects = new HashSet<object>(original._visitedObjects);
