<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net12.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RuntimeFrameworkVersion>12.0.0-alpha.1.26562.105</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <TestImage>$(MSBuildThisFileDirectory)..\tests\borrowed-F001\image</TestImage>
    <QuicImage>$(MSBuildThisFileDirectory)..\quic-owner\image</QuicImage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.13.0" />
    <Reference Include="$(TestImage)\Microsoft.*.dll" Exclude="$(TestImage)\*Test*.dll;$(TestImage)\*Generator*.dll" Private="true" />
    <Reference Include="$(QuicImage)\Microsoft.AspNetCore.Server.Kestrel.Transport.Quic.dll" Private="true" />
  </ItemGroup>
  <Target Name="ValidateTestedOwner" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(TestImage)\Microsoft.AspNetCore.Server.Kestrel.Core.dll')" Text="Execute and freeze the original scoped owning tests first." />
    <Error Condition="!Exists('$(QuicImage)\Microsoft.AspNetCore.Server.Kestrel.Transport.Quic.dll')" Text="Capture and check the actual baseline QUIC owner first." />
  </Target>
</Project>
