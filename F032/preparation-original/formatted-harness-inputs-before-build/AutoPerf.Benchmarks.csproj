<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net12.0</TargetFramework>
    <RuntimeFrameworkVersion>12.0.0-alpha.1.26562.105</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <Optimize>true</Optimize>
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <BuildProjectReferences>false</BuildProjectReferences>
    <BuildInParallel>false</BuildInParallel>
    <UseSharedCompilation>false</UseSharedCompilation>
    <AspNetCoreRoot>$(AUTOPERF_ASPNETCORE_ROOT)</AspNetCoreRoot>
    <TestBin>$(AspNetCoreRoot)\artifacts\bin\Microsoft.AspNetCore.Server.HttpSys.FunctionalTests\Release\net12.0</TestBin>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.13.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="12.0.0-alpha.1.26562.105" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="12.0.0-alpha.1.26562.105" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="12.0.0-alpha.1.26562.105" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="12.0.0-alpha.1.26562.105" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Hosting\Abstractions\src\Microsoft.AspNetCore.Hosting.Abstractions.csproj" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Hosting\Hosting\src\Microsoft.AspNetCore.Hosting.csproj" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Hosting\Server.Abstractions\src\Microsoft.AspNetCore.Hosting.Server.Abstractions.csproj" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Http\Http.Abstractions\src\Microsoft.AspNetCore.Http.Abstractions.csproj" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Http\Http.Features\src\Microsoft.AspNetCore.Http.Features.csproj" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Http\Http\src\Microsoft.AspNetCore.Http.csproj" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Http\Http.Extensions\src\Microsoft.AspNetCore.Http.Extensions.csproj" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Servers\HttpSys\src\Microsoft.AspNetCore.Server.HttpSys.csproj" />
    <Reference Include="$(TestBin)\Microsoft.*.dll"
      Exclude="$(TestBin)\*Test*.dll;$(TestBin)\*Generator*.dll;$(TestBin)\Microsoft.AspNetCore.Hosting.Abstractions.dll;$(TestBin)\Microsoft.AspNetCore.Hosting.dll;$(TestBin)\Microsoft.AspNetCore.Hosting.Server.Abstractions.dll;$(TestBin)\Microsoft.AspNetCore.Http.Abstractions.dll;$(TestBin)\Microsoft.AspNetCore.Http.Features.dll;$(TestBin)\Microsoft.AspNetCore.Http.dll;$(TestBin)\Microsoft.AspNetCore.Http.Extensions.dll;$(TestBin)\Microsoft.AspNetCore.Server.HttpSys.dll"
      Private="true" />
  </ItemGroup>
  <Target Name="ValidateSourceRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(AspNetCoreRoot)' == ''" Text="Set AUTOPERF_ASPNETCORE_ROOT to the independently validated source checkout with prebuilt Release HTTP.sys projects." />
    <Error Condition="!Exists('$(TestBin)\Microsoft.AspNetCore.Server.HttpSys.dll')" Text="Build the actual HTTP.sys owning functional tests Release first;do not substitute installed ASP.NET assemblies." />
  </Target>
</Project>
