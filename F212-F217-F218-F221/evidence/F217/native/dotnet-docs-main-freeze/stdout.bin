received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"1bea2d8730b6981d5dcf9fb5add527c95a924b62","url":"https://api.github.com/repos/dotnet/docs/commits/1bea2d8730b6981d5dcf9fb5add527c95a924b62","html_url":"https://github.com/dotnet/docs/commit/1bea2d8730b6981d5dcf9fb5add527c95a924b62"}],"stats":{"total":59,"additions":59,"deletions":0},"files":[{"sha":"a22ac788b6173b79a6c00d4b80f827625ca5fc7d","filename":"docs/core/compatibility/11.md","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/dotnet/docs/blob/c023f59008561b0633204140aaccd803139ac435/docs%2Fcore%2Fcompatibility%2F11.md","raw_url":"https://github.com/dotnet/docs/raw/c023f59008561b0633204140aaccd803139ac435/docs%2Fcore%2Fcompatibility%2F11.md","contents_url":"https://api.github.com/repos/dotnet/docs/contents/docs%2Fcore%2Fcompatibility%2F11.md?ref=c023f59008561b0633204140aaccd803139ac435","patch":"@@ -113,6 +113,7 @@ See [Breaking changes in EF Core 11](/ef/core/what-is-new/ef-core-11.0/breaking-\n |-------------------------------------------------------------------|-------------------|\n | [HttpClient high-cardinality metrics use observable counters](networking/11/http-metrics-observable-counters.md) | Behavioral change |\n | [SslStream server-side AIA certificate downloads disabled by default](networking/11/sslstream-aia-downloads-disabled.md) | Behavioral change |\n+| [Uri parsing and UriBuilder validation changes](networking/11/uri-parsing-validation.md) | Behavioral change |\n \n ## .NET MAUI\n "},{"sha":"10aca7d753e0917213362ad847d4fb8cba8bf033","filename":"docs/core/compatibility/networking/11/uri-parsing-validation.md","status":"added","additions":56,"deletions":0,"changes":56,"blob_url":"https://github.com/dotnet/docs/blob/c023f59008561b0633204140aaccd803139ac435/docs%2Fcore%2Fcompatibility%2Fnetworking%2F11%2Furi-parsing-validation.md","raw_url":"https://github.com/dotnet/docs/raw/c023f59008561b0633204140aaccd803139ac435/docs%2Fcore%2Fcompatibility%2Fnetworking%2F11%2Furi-parsing-validation.md","contents_url":"https://api.github.com/repos/dotnet/docs/contents/docs%2Fcore%2Fcompatibility%2Fnetworking%2F11%2Furi-parsing-validation.md?ref=c023f59008561b0633204140aaccd803139ac435","patch":"@@ -0,0 +1,56 @@\n+---\n+title: \"Breaking change: Uri parsing and UriBuilder validation changes\"\n+description: \"Learn about the breaking changes in .NET 11 involving Uri parsing and UriBuilder host validation.\"\n+ms.date: 10/21/2026\n+ai-usage: ai-assisted\n+ms.custom: https://github.com/dotnet/docs/issues/55744\n+---\n+\n+# Uri parsing and UriBuilder validation changes\n+\n+In .NET 11, several parsing and validation behaviors in <xref:System.Uri> and <xref:System.UriBuilder> have been tightened to align more strictly with the URI specification and eliminate parsing discrepancies across constructor overloads and factories.\n+\n+## Version introduced\n+\n+.NET 11 GA\n+\n+## Previous behavior\n+\n+Previously, the following behaviors were permitted or exhibited:\n+\n+1. **Missing IPv6 path delimiter:** A URI string without a delimiter between an IPv6 address and the path (such as `\"http://[::]extra\"`) was parsed the same as if a delimiter was present (`\"http://[::]/extra\"`).\n+2. **`UriBuilder.Host` accepted composite or invalid values:** Setting the <xref:System.UriBuilder.Host?displayProperty=nameWithType> property allowed values containing path delimiters or user information (such as `\"contoso.com/path\"` or `\"user@host\"`), potentially altering other URI components when the builder combined values via <xref:System.UriBuilder.Uri?displayProperty=nameWithType> or <xref:System.UriBuilder.ToString?displayProperty=nameWithType>.\n+3. **IPv6 length prefixes:** <xref:System.Uri> allowed parsing of IPv6 length prefixes (such as `\"/64\"` in `\"http://[AB::/64]/path\"`).\n+4. **Embedded IPv4 octal segments:** <xref:System.Uri> allowed an octal value in the last segment of an IPv4 address embedded within an IPv6 address (for example, `\"http://[::1.2.3.04]/\"` was parsed, whereas `\"http://[::1.2.03.4]/\"` was rejected).\n+5. **Relative URI normalization discrepancy:** `new Uri(\"p%41th\", UriKind.Relative)` normalized the relative URI input to `\"pAth\"`, whereas `Uri.TryCreate(\"p%41th\", UriKind.Relative, out uri)` left the value unnormalized as `\"p%41th\"`.\n+\n+## New behavior\n+\n+Starting in .NET 11:\n+\n+1. **IPv6 path delimiter required:** URI parsing enforces that a delimiter (`/`) is present after an IPv6 host. Parsing strings like `\"http://[::]extra\"` now throws <xref:System.UriFormatException> or causes <xref:System.Uri.TryCreate*?displayProperty=nameWithType> to return `false`.\n+2. **`UriBuilder.Host` validates input:** The <xref:System.UriBuilder.Host?displayProperty=nameWithType> property setter performs best-effort validation and rejects inputs that would alter other URI components. Assigning values such as `\"contoso.com/path\"` or `\"user@host\"` throws <xref:System.ArgumentException>. Certain invalid host formats, such as `\"[127.0.0.1]\"`, are also caught early.\n+3. **IPv6 length prefixes rejected:** If an IPv6 length prefix is present in the input, URI parsing fails with <xref:System.UriFormatException>. Allowed characters in the zone ID (IPv6 scope identifier) are also more strictly constrained.\n+4. **Embedded IPv4 octal segments rejected:** Octal values are rejected in any segment of an IPv4 address embedded in an IPv6 address. Parsing strings such as `\"http://[::1.2.3.04]/\"` now fails.\n+5. **Consistent relative URI normalization:** <xref:System.Uri.%23ctor(System.String,System.UriKind)> and <xref:System.Uri.TryCreate(System.String,System.UriKind,System.Uri@)> apply identical normalization rules. Passing `\"p%41th\"` to either API normalizes the value to `\"pAth\"`.\n+\n+## Type of breaking change\n+\n+This change is a [behavioral change](../../categories.md#behavioral-change).\n+\n+## Reason for change\n+\n+These changes enforce stricter adherence to RFC URI standards, improve best-effort validation in <xref:System.UriBuilder> to catch inputs that would affect other URI components, and eliminate subtle differences between <xref:System.Uri> constructors and <xref:System.Uri.TryCreate*?displayProperty=nameWithType>.\n+\n+## Recommended action\n+\n+Most applications will not need changes. However, if your application:\n+\n+- Uses <xref:System.UriBuilder.Host?displayProperty=nameWithType> to set composite values containing paths or user credentials, update the code to assign the individual <xref:System.UriBuilder.Path>, <xref:System.UriBuilder.UserName>, or <xref:System.UriBuilder.Password> properties directly.\n+- Parses IPv6 URIs without trailing delimiters or with CIDR length prefixes, ensure the input URIs are formatted with a path delimiter and without prefix lengths.\n+\n+## Affected APIs\n+\n+- <xref:System.Uri.%23ctor*>\n+- <xref:System.Uri.TryCreate*?displayProperty=fullName>\n+- <xref:System.UriBuilder.Host?displayProperty=fullName>"},{"sha":"e00daa1567206a7a995df2d3719d35dd0783aafa","filename":"docs/core/compatibility/toc.yml","status":"modified","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/dotnet/docs/blob/c023f59008561b0633204140aaccd803139ac435/docs%2Fcore%2Fcompatibility%2Ftoc.yml","raw_url":"https://github.com/dotnet/docs/raw/c023f59008561b0633204140aaccd803139ac435/docs%2Fcore%2Fcompatibility%2Ftoc.yml","contents_url":"https://api.github.com/repos/dotnet/docs/contents/docs%2Fcore%2Fcompatibility%2Ftoc.yml?ref=c023f59008561b0633204140aaccd803139ac435","patch":"@@ -124,6 +124,8 @@ items:\n                 href: networking/11/http-metrics-observable-counters.md\n               - name: SslStream server-side AIA certificate downloads disabled by default\n                 href: networking/11/sslstream-aia-downloads-disabled.md\n+              - name: Uri parsing and UriBuilder validation changes\n+                href: networking/11/uri-parsing-validation.md\n           - name: .NET MAUI\n             items:\n               - name: Android x86 is not supported"}]}