m/jaslawinMs/aspnetcore/commit/a412ffec9328562a1b7e27945f0e40ebdca3c35d"},{"sha":"a61c99060627afe844e49ed09e4d30b4311edcd9","url":"https://api.github.com/repos/jaslawinMs/aspnetcore/commits/a61c99060627afe844e49ed09e4d30b4311edcd9","html_url":"https://github.com/jaslawinMs/aspnetcore/commit/a61c99060627afe844e49ed09e4d30b4311edcd9"}]},"status":"ahead","ahead_by":1,"behind_by":0,"total_commits":1,"commits":[{"sha":"619ced41b0946739f6c5d851f335608a425b6d13","node_id":"C_kwDOVtqThdoAKDYxOWNlZDQxYjA5NDY3MzlmNmM1ZDg1MWYzMzU2MDhhNDI1YjZkMTM","commit":{"author":{"name":"Jaro Slawinski","email":"jaslawin@microsoft.com","date":"2026-11-18T05:42:43Z"},"committer":{"name":"Jaro Slawinski","email":"jaslawin@microsoft.com","date":"2026-11-18T05:42:43Z"},"message":"Avoid duplicate lookups in TempData conditional collection removal\n\nUse the private Data dictionary TryGetValue, not the consuming public member. Preserve lazy loading, null, equality and retention, including the final Remove(key) result after reentrant equality. Add eight first-access preservation rows. F040 retains three completed RemoveAndRestore comparisons with restoration inside timing; no isolated Remove, cookie or application speedup claim.\n\nCo-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>\nCopilot-Session: a24edcfd-1bb9-4160-afce-6ba54b1b7f00","tree":{"sha":"ea171fb1a6423a32234e92d354900c6cd7c93e56","url":"https://api.github.com/repos/jaslawinMs/aspnetcore/git/trees/ea171fb1a6423a32234e92d354900c6cd7c93e56"},"url":"https://api.github.com/repos/jaslawinMs/aspnetcore/git/commits/619ced41b0946739f6c5d851f335608a425b6d13","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/jaslawinMs/aspnetcore/commits/619ced41b0946739f6c5d851f335608a425b6d13","html_url":"https://github.com/jaslawinMs/aspnetcore/commit/619ced41b0946739f6c5d851f335608a425b6d13","comments_url":"https://api.github.com/repos/jaslawinMs/aspnetcore/commits/619ced41b0946739f6c5d851f335608a425b6d13/comments","author":{"login":"jaslawinMs","id":66098041,"node_id":"MDQ6VXNlcjY2MDk4MDQx","avatar_url":"https://avatars.githubusercontent.com/u/66098041?v=4","gravatar_id":"","url":"https://api.github.com/users/jaslawinMs","html_url":"https://github.com/jaslawinMs","followers_url":"https://api.github.com/users/jaslawinMs/followers","following_url":"https://api.github.com/users/jaslawinMs/following{/other_user}","gists_url":"https://api.github.com/users/jaslawinMs/gists{/gist_id}","starred_url":"https://api.github.com/users/jaslawinMs/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jaslawinMs/subscriptions","organizations_url":"https://api.github.com/users/jaslawinMs/orgs","repos_url":"https://api.github.com/users/jaslawinMs/repos","events_url":"https://api.github.com/users/jaslawinMs/events{/privacy}","received_events_url":"https://api.github.com/users/jaslawinMs/received_events","type":"User","user_view_type":"public","site_admin":true},"committer":{"login":"jaslawinMs","id":66098041,"node_id":"MDQ6VXNlcjY2MDk4MDQx","avatar_url":"https://avatars.githubusercontent.com/u/66098041?v=4","gravatar_id":"","url":"https://api.github.com/users/jaslawinMs","html_url":"https://github.com/jaslawinMs","followers_url":"https://api.github.com/users/jaslawinMs/followers","following_url":"https://api.github.com/users/jaslawinMs/following{/other_user}","gists_url":"https://api.github.com/users/jaslawinMs/gists{/gist_id}","starred_url":"https://api.github.com/users/jaslawinMs/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jaslawinMs/subscriptions","organizations_url":"https://api.github.com/users/jaslawinMs/orgs","repos_url":"https://api.github.com/users/jaslawinMs/repos","events_url":"https://api.github.com/users/jaslawinMs/events{/privacy}","received_events_url":"https://api.github.com/users/jaslawinMs/received_events","type":"User","user_view_type":"public","site_admin":true},"parents":[{"sha":"37e809ead5824bc753a1c3d56f11615bdb1296c5","url":"https://api.github.com/repos/jaslawinMs/aspnetcore/commits/37e809ead5824bc753a1c3d56f11615bdb1296c5","html_url":"https://github.com/jaslawinMs/aspnetcore/commit/37e809ead5824bc753a1c3d56f11615bdb1296c5"}]}],"files":[{"sha":"787a185f377e81fa48821766ed7c48fd0a14888d","filename":"src/Components/Endpoints/src/TempData/TempData.cs","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/jaslawinMs/aspnetcore/blob/619ced41b0946739f6c5d851f335608a425b6d13/src%2FComponents%2FEndpoints%2Fsrc%2FTempData%2FTempData.cs","raw_url":"https://github.com/jaslawinMs/aspnetcore/raw/619ced41b0946739f6c5d851f335608a425b6d13/src%2FComponents%2FEndpoints%2Fsrc%2FTempData%2FTempData.cs","contents_url":"https://api.github.com/repos/jaslawinMs/aspnetcore/contents/src%2FComponents%2FEndpoints%2Fsrc%2FTempData%2FTempData.cs?ref=619ced41b0946739f6c5d851f335608a425b6d13","patch":"@@ -151,7 +151,7 @@ public void Clear()\n \n     bool ICollection<KeyValuePair<string, object?>>.Remove(KeyValuePair<string, object?> item)\n     {\n-        if (ContainsKey(item.Key) && Equals(Peek(item.Key), item.Value))\n+        if (Data.TryGetValue(item.Key, out var value) && Equals(value, item.Value))\n         {\n             return Remove(item.Key);\n         }"},{"sha":"0ad511656db2c03b4cdfc216905f5deca50d1620","filename":"src/Components/Endpoints/test/TempData/TempDataTest.cs","status":"modified","additions":47,"deletions":0,"changes":47,"blob_url":"https://github.com/jaslawinMs/aspnetcore/blob/619ced41b0946739f6c5d851f335608a425b6d13/src%2FComponents%2FEndpoints%2Ftest%2FTempData%2FTempDataTest.cs","raw_url":"https://github.com/jaslawinMs/aspnetcore/raw/619ced41b0946739f6c5d851f335608a425b6d13/src%2FComponents%2FEndpoints%2Ftest%2FTempData%2FTempDataTest.cs","contents_url":"https://api.github.com/repos/jaslawinMs/aspnetcore/contents/src%2FComponents%2FEndpoints%2Ftest%2FTempData%2FTempDataTest.cs?ref=619ced41b0946739f6c5d851f335608a425b6d13","patch":"@@ -143,6 +143,53 @@ public void Remove_ReturnsFalseForNonExistentKey()\n         Assert.False(result);\n     }\n \n+    [Theory]\n+    [InlineData(\"Message\", \"hello\", true, false, true)]\n+    [InlineData(\"MESSAGE\", \"hello\", true, false, true)]\n+    [InlineData(\"Message\", \"HELLO\", false, true, true)]\n+    [InlineData(\"Message\", null, false, true, true)]\n+    [InlineData(\"Null\", null, true, true, false)]\n+    [InlineData(\"Null\", \"hello\", false, true, true)]\n+    [InlineData(\"Missing\", null, false, true, true)]\n+    [InlineData(\"Missing\", \"hello\", false, true, true)]\n+    public void CollectionRemove_UpdatesRetainedValues_WhenFirstAccessTriggersLazyLoad(\n+        string key, object value, bool expected, bool messageRetained, bool nullRetained)\n+    {\n+        var numberOfLoads = 0;\n+        var tempData = new TempData(() =>\n+        {\n+            numberOfLoads++;\n+            return new Dictionary<string, object>\n+            {\n+                [\"Message\"] = \"hello\",\n+                [\"Null\"] = null,\n+            };\n+        });\n+        var collection = (ICollection<KeyValuePair<string, object>>)tempData;\n+        var item = new KeyValuePair<string, object>(key, value);\n+        Assert.False(tempData.WasLoaded);\n+        Assert.Equal(0, numberOfLoads);\n+\n+        var result = collection.Remove(item);\n+\n+        Assert.Equal(expected, result);\n+        Assert.False(collection.Remove(item));\n+        var saved = tempData.Save();\n+        Assert.True(tempData.WasLoaded);\n+        Assert.Equal(1, numberOfLoads);\n+        Assert.Equal((messageRetained ? 1 : 0) + (nullRetained ? 1 : 0), saved.Count);\n+        Assert.Equal(messageRetained, saved.ContainsKey(\"Message\"));\n+        Assert.Equal(nullRetained, saved.ContainsKey(\"Null\"));\n+        if (messageRetained)\n+        {\n+            Assert.Equal(\"hello\", saved[\"Message\"]);\n+        }\n+        if (nullRetained)\n+        {\n+            Assert.Null(saved[\"Null\"]);\n+        }\n+    }\n+\n     [Fact]\n     public void Save_ReturnsOnlyRetainedKeys()\n     {"}]}