[[{"sha":"8ad6e99b561b8e270c993e861402cb6e93f0a0f6","filename":"src/Mvc/Mvc.Core/src/Formatters/SystemTextJsonInputFormatter.cs","status":"modified","additions":14,"deletions":5,"changes":19,"blob_url":"https://github.com/dotnet/aspnetcore/blob/36dfd7b369628a314d5f7d1f43a5bbf4f7227899/src%2FMvc%2FMvc.Core%2Fsrc%2FFormatters%2FSystemTextJsonInputFormatter.cs","raw_url":"https://github.com/dotnet/aspnetcore/raw/36dfd7b369628a314d5f7d1f43a5bbf4f7227899/src%2FMvc%2FMvc.Core%2Fsrc%2FFormatters%2FSystemTextJsonInputFormatter.cs","contents_url":"https://api.github.com/repos/dotnet/aspnetcore/contents/src%2FMvc%2FMvc.Core%2Fsrc%2FFormatters%2FSystemTextJsonInputFormatter.cs?ref=36dfd7b369628a314d5f7d1f43a5bbf4f7227899","patch":"@@ -3,6 +3,7 @@\n \n using System.Text;\n using System.Text.Json;\n+using Microsoft.AspNetCore.Mvc.Core;\n using Microsoft.Extensions.Logging;\n \n namespace Microsoft.AspNetCore.Mvc.Formatters;\n@@ -117,11 +118,19 @@ public sealed override async Task<InputFormatterResult> ReadRequestBodyAsync(\n \n         if (model == null && !context.TreatEmptyInputAsDefaultValue)\n         {\n-            // Some nonempty inputs might deserialize as null, for example whitespace,\n-            // or the JSON-encoded value \"null\". The upstream BodyModelBinder needs to\n-            // be notified that we don't regard this as a real input so it can register\n-            // a model binding error.\n-            return InputFormatterResult.NoValue();\n+            // The request body contained a valid JSON value (e.g. the literal \"null\")\n+            // that deserialized to null, but the parameter is required. Return a\n+            // specific error message rather than the generic \"non-empty request body\"\n+            // message, because the body is not empty — it just contains null.\n+            var modelName = context.ModelName ?? string.Empty;\n+            var modelDisplayName = context.Metadata?.DisplayName\n+                ?? context.Metadata?.Name\n+                ?? modelName;\n+            context.ModelState.TryAddModelError(\n+                modelName,\n+                Resources.FormatFormatExceptionMessage_NullJsonIsInvalid(modelDisplayName));\n+\n+            return InputFormatterResult.Failure();\n         }\n         else\n         {"},{"sha":"be08615c1af46c9ebef7eed6e652a69db1592d2a","filename":"src/Mvc/Mvc.Core/src/Resources.resx","status":"modified","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/dotnet/aspnetcore/blob/36dfd7b369628a314d5f7d1f43a5bbf4f7227899/src%2FMvc%2FMvc.Core%2Fsrc%2FResources.resx","raw_url":"https://github.com/dotnet/aspnetcore/raw/36dfd7b369628a314d5f7d1f43a5bbf4f7227899/src%2FMvc%2FMvc.Core%2Fsrc%2FResources.resx","contents_url":"https://api.github.com/repos/dotnet/aspnetcore/contents/src%2FMvc%2FMvc.Core%2Fsrc%2FResources.resx?ref=36dfd7b369628a314d5f7d1f43a5bbf4f7227899","patch":"@@ -300,6 +300,9 @@\n   <data name=\"ModelBinding_MissingRequestBodyRequiredMember\" xml:space=\"preserve\">\n     <value>A non-empty request body is required.</value>\n   </data>\n+  <data name=\"FormatExceptionMessage_NullJsonIsInvalid\" xml:space=\"preserve\">\n+    <value>A JSON request body containing a null value is not valid for the required '{0}' parameter or property.</value>\n+  </data>\n   <data name=\"ValueProviderResult_NoConverterExists\" xml:space=\"preserve\">\n     <value>The parameter conversion from type '{0}' to type '{1}' failed because no type converter can convert between these types.</value>\n   </data>"},{"sha":"c4ee014ad53373a18fbfde0386e493178f7d4cd7","filename":"src/Mvc/Mvc.Core/test/Formatters/JsonInputFormatterTestBase.cs","status":"modified","additions":29,"deletions":13,"changes":42,"blob_url":"https://github.com/dotnet/aspnetcore/blob/36dfd7b369628a314d5f7d1f43a5bbf4f7227899/src%2FMvc%2FMvc.Core%2Ftest%2FFormatters%2FJsonInputFormatterTestBase.cs","raw_url":"https://github.com/dotnet/aspnetcore/raw/36dfd7b369628a314d5f7d1f43a5bbf4f7227899/src%2FMvc%2FMvc.Core%2Ftest%2FFormatters%2FJsonInputFormatterTestBase.cs","contents_url":"https://api.github.com/repos/dotnet/aspnetcore/contents/src%2FMvc%2FMvc.Core%2Ftest%2FFormatters%2FJsonInputFormatterTestBase.cs?ref=36dfd7b369628a314d5f7d1f43a5bbf4f7227899","patch":"@@ -436,32 +436,48 @@ public virtual async Task ReadAsync_UsesTryAddModelValidationErrorsToModelState(\n         Assert.IsType<TooManyModelErrorsException>(error.Exception);\n     }\n \n-    [Theory]\n-    [InlineData(\"null\", true, true)]\n-    [InlineData(\"null\", false, false)]\n-    public async Task ReadAsync_WithInputThatDeserializesToNull_SetsModelOnlyIfAllowingEmptyInput(\n-        string content,\n-        bool treatEmptyInputAsDefaultValue,\n-        bool expectedIsModelSet)\n+    [Fact]\n+    public async Task ReadAsync_WithNullJsonInput_WhenAllowingEmptyInput_SetsModelToNull()\n     {\n-        // Arrange\n         var formatter = GetInputFormatter();\n \n-        var contentBytes = Encoding.UTF8.GetBytes(content);\n+        var contentBytes = Encoding.UTF8.GetBytes(\"null\");\n         var httpContext = GetHttpContext(contentBytes);\n \n         var formatterContext = CreateInputFormatterContext(\n             typeof(string),\n             httpContext,\n-            treatEmptyInputAsDefaultValue: treatEmptyInputAsDefaultValue);\n+            treatEmptyInputAsDefaultValue: true);\n \n-        // Act\n         var result = await formatter.ReadAsync(formatterContext);\n \n-        // Assert\n         Assert.False(result.HasError);\n-        Assert.Equal(expectedIsModelSet, result.IsModelSet);\n+        Assert.True(result.IsModelSet);\n+        Assert.Null(result.Model);\n+    }\n+\n+    [Fact]\n+    public async Task ReadAsync_WithNullJsonInput_WhenNotAllowingEmptyInput_ReturnsFailureWithDistinctError()\n+    {\n+        var formatter = GetInputFormatter();\n+\n+        var contentBytes = Encoding.UTF8.GetBytes(\"null\");\n+        var httpContext = GetHttpContext(contentBytes);\n+\n+        var formatterContext = CreateInputFormatterContext(\n+            typeof(string),\n+            httpContext,\n+            treatEmptyInputAsDefaultValue: false);\n+\n+        var result = await formatter.ReadAsync(formatterContext);\n+\n+        Assert.True(result.HasError);\n+        Assert.False(result.IsModelSet);\n         Assert.Null(result.Model);\n+\n+        var error = Assert.Single(formatterContext.ModelState[string.Empty].Errors);\n+        Assert.Contains(\"null\", error.ErrorMessage, StringComparison.OrdinalIgnoreCase);\n+        Assert.DoesNotContain(\"non-empty\", error.ErrorMessage, StringComparison.OrdinalIgnoreCase);\n     }\n \n     [Fact]"},{"sha":"fcd27948ee2220bfc022f2ed6e9aaaeb611701ad","filename":"src/Mvc/Mvc.NewtonsoftJson/src/NewtonsoftJsonInputFormatter.cs","status":"modified","additions":17,"deletions":4,"changes":21,"blob_url":"https://github.com/dotnet/aspnetcore/blob/36dfd7b369628a314d5f7d1f43a5bbf4f7227899/src%2FMvc%2FMvc.NewtonsoftJson%2Fsrc%2FNewtonsoftJsonInputFormatter.cs","raw_url":"https://github.com/dotnet/aspnetcore/raw/36dfd7b369628a314d5f7d1f43a5bbf4f7227899/src%2FMvc%2FMvc.NewtonsoftJson%2Fsrc%2FNewtonsoftJsonInputFormatter.cs","contents_url":"https://api.github.com/repos/dotnet/aspnetcore/contents/src%2FMvc%2FMvc.NewtonsoftJson%2Fsrc%2FNewtonsoftJsonInputFormatter.cs?ref=36dfd7b369628a314d5f7d1f43a5bbf4f7227899","patch":"@@ -140,6 +140,7 @@ public override async Task<InputFormatterResult> ReadRequestBodyAsync(\n         var successful = true;\n         Exception? exception = null;\n         object? model;\n+        var hadJsonContent = false;\n \n         using (var streamReader = context.ReaderFactory(readStream, encoding))\n         {\n@@ -159,6 +160,9 @@ public override async Task<InputFormatterResult> ReadRequestBodyAsync(\n             try\n             {\n                 model = jsonSerializer.Deserialize(jsonReader, type);\n+                // Track whether JSON content was actually read. A token type other\n+                // than None indicates the reader parsed at least one JSON token.\n+                hadJsonContent = jsonReader.TokenType != JsonToken.None;\n             }\n             finally\n             {\n@@ -177,10 +181,19 @@ public override async Task<InputFormatterResult> ReadRequestBodyAsync(\n         {\n             if (model == null && !context.TreatEmptyInputAsDefaultValue)\n             {\n-                // Some nonempty inputs might deserialize as null, for example whitespace,\n-                // or the JSON-encoded value \"null\". The upstream BodyModelBinder needs to\n-                // be notified that we don't regard this as a real input so it can register\n-                // a model binding error.\n+                if (hadJsonContent)\n+                {\n+                    // The request body contained a valid JSON value (e.g. the literal \"null\")\n+                    // that deserialized to null, but the parameter is required.\n+                    var modelName = context.ModelName;\n+                    var modelDisplayName = context.Metadata.DisplayName ?? context.Metadata.Name ?? modelName;\n+                    context.ModelState.TryAddModelError(\n+                        modelName,\n+                        Resources.FormatFormatExceptionMessage_NullJsonIsInvalid(modelDisplayName));\n+\n+                    return InputFormatterResult.Failure();\n+                }\n+\n                 return InputFormatterResult.NoValue();\n             }\n             else"},{"sha":"b3efa82d3105cd6d2eb2f8aada713f66818abc63","filename":"src/Mvc/Mvc.NewtonsoftJson/src/Resources.resx","status":"modified","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/dotnet/aspnetcore/blob/36dfd7b369628a314d5f7d1f43a5bbf4f7227899/src%2FMvc%2FMvc.NewtonsoftJson%2Fsrc%2FResources.resx","raw_url":"https://github.com/dotnet/aspnetcore/raw/36dfd7b369628a314d5f7d1f43a5bbf4f7227899/src%2FMvc%2FMvc.NewtonsoftJson%2Fsrc%2FResources.resx","contents_url":"https://api.github.com/repos/dotnet/aspnetcore/contents/src%2FMvc%2FMvc.NewtonsoftJson%2Fsrc%2FResources.resx?ref=36dfd7b369628a314d5f7d1f43a5bbf4f7227899","patch":"@@ -141,4 +141,7 @@\n   <data name=\"TempData_CannotSerializeType\" xml:space=\"preserve\">\n     <value>The '{0}' cannot serialize an object of type '{1}'.</value>\n   </data>\n+  <data name=\"FormatExceptionMessage_NullJsonIsInvalid\" xml:space=\"preserve\">\n+    <value>A JSON request body containing a null value is not valid for the required '{0}' parameter or property.</value>\n+  </data>\n </root>"},{"sha":"dbcd8bcd5a320244be70c8fe812055124423606c","filename":"src/Mvc/Mvc.NewtonsoftJson/test/NewtonsoftJsonInputFormatterTest.cs","status":"modified","additions":37,"deletions":5,"changes":42,"blob_url":"https://github.com/dotnet/aspnetcore/blob/36dfd7b369628a314d5f7d1f43a5bbf4f7227899/src%2FMvc%2FMvc.NewtonsoftJson%2Ftest%2FNewtonsoftJsonInputFormatterTest.cs","raw_url":"https://github.com/dotnet/aspnetcore/raw/36dfd7b369628a314d5f7d1f43a5bbf4f7227899/src%2FMvc%2FMvc.NewtonsoftJson%2Ftest%2FNewtonsoftJsonInputFormatterTest.cs","contents_url":"https://api.github.com/repos/dotnet/aspnetcore/contents/src%2FMvc%2FMvc.NewtonsoftJson%2Ftest%2FNewtonsoftJsonInputFormatterTest.cs?ref=36dfd7b369628a314d5f7d1f43a5bbf4f7227899","patch":"@@ -212,12 +212,44 @@ public override Task JsonFormatter_EscapedKeys_SingleQuote()\n         return base.JsonFormatter_EscapedKeys_SingleQuote();\n     }\n \n-    [Theory]\n-    [InlineData(\" \", true, true)]\n-    [InlineData(\" \", false, false)]\n-    public Task ReadAsync_WithInputThatDeserializesToNull_SetsModelOnlyIfAllowingEmptyInput_WhenValueIsWhitespaceString(string content, bool treatEmptyInputAsDefaultValue, bool expectedIsModelSet)\n+    [Fact]\n+    public async Task ReadAsync_WithWhitespaceInput_WhenAllowingEmptyInput_SetsModelToNull()\n+    {\n+        var formatter = GetInputFormatter();\n+\n+        var contentBytes = Encoding.UTF8.GetBytes(\" \");\n+        var httpContext = GetHttpContext(contentBytes);\n+\n+        var formatterContext = CreateInputFormatterContext(\n+            typeof(string),\n+            httpContext,\n+            treatEmptyInputAsDefaultValue: true);\n+\n+        var result = await formatter.ReadAsync(formatterContext);\n+\n+        Assert.False(result.HasError);\n+        Assert.True(result.IsModelSet);\n+        Assert.Null(result.Model);\n+    }\n+\n+    [Fact]\n+    public async Task ReadAsync_WithWhitespaceInput_WhenNotAllowingEmptyInput_ReturnsNoValue()\n     {\n-        return base.ReadAsync_WithInputThatDeserializesToNull_SetsModelOnlyIfAllowingEmptyInput(content, treatEmptyInputAsDefaultValue, expectedIsModelSet);\n+        var formatter = GetInputFormatter();\n+\n+        var contentBytes = Encoding.UTF8.GetBytes(\" \");\n+        var httpContext = GetHttpContext(contentBytes);\n+\n+        var formatterContext = CreateInputFormatterContext(\n+            typeof(string),\n+            httpContext,\n+            treatEmptyInputAsDefaultValue: false);\n+\n+        var result = await formatter.ReadAsync(formatterContext);\n+\n+        Assert.False(result.HasError);\n+        Assert.False(result.IsModelSet);\n+        Assert.Null(result.Model);\n     }\n \n     [Theory]"}]]