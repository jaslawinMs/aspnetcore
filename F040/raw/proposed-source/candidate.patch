+        Assert.Equal((messageRetained ? 1 : 0) + (nullRetained ? 1 : 0), saved.Count);
+        Assert.Equal(messageRetained, saved.ContainsKey("Message"));
+        Assert.Equal(nullRetained, saved.ContainsKey("Null"));
+        if (messageRetained)
+        {
+            Assert.Equal("hello", saved["Message"]);
+        }
