6881890f564b/comments","author":{"login":"jaslawinMs","id":66098041,"node_id":"MDQ6VXNlcjY2MDk4MDQx","avatar_url":"https://avatars.githubusercontent.com/u/66098041?v=4","gravatar_id":"","url":"https://api.github.com/users/jaslawinMs","html_url":"https://github.com/jaslawinMs","followers_url":"https://api.github.com/users/jaslawinMs/followers","following_url":"https://api.github.com/users/jaslawinMs/following{/other_user}","gists_url":"https://api.github.com/users/jaslawinMs/gists{/gist_id}","starred_url":"https://api.github.com/users/jaslawinMs/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jaslawinMs/subscriptions","organizations_url":"https://api.github.com/users/jaslawinMs/orgs","repos_url":"https://api.github.com/users/jaslawinMs/repos","events_url":"https://api.github.com/users/jaslawinMs/events{/privacy}","received_events_url":"https://api.github.com/users/jaslawinMs/received_events","type":"User","user_view_type":"public","site_admin":true},"committer":{"login":"jaslawinMs","id":66098041,"node_id":"MDQ6VXNlcjY2MDk4MDQx","avatar_url":"https://avatars.githubusercontent.com/u/66098041?v=4","gravatar_id":"","url":"https://api.github.com/users/jaslawinMs","html_url":"https://github.com/jaslawinMs","followers_url":"https://api.github.com/users/jaslawinMs/followers","following_url":"https://api.github.com/users/jaslawinMs/following{/other_user}","gists_url":"https://api.github.com/users/jaslawinMs/gists{/gist_id}","starred_url":"https://api.github.com/users/jaslawinMs/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jaslawinMs/subscriptions","organizations_url":"https://api.github.com/users/jaslawinMs/orgs","repos_url":"https://api.github.com/users/jaslawinMs/repos","events_url":"https://api.github.com/users/jaslawinMs/events{/privacy}","received_events_url":"https://api.github.com/users/jaslawinMs/received_events","type":"User","user_view_type":"public","site_admin":true},"parents":[{"sha":"37e809ead5824bc753a1c3d56f11615bdb1296c5","url":"https://api.github.com/repos/jaslawinMs/aspnetcore/commits/37e809ead5824bc753a1c3d56f11615bdb1296c5","html_url":"https://github.com/jaslawinMs/aspnetcore/commit/37e809ead5824bc753a1c3d56f11615bdb1296c5"}]}],"files":[{"sha":"6db32dc57eaa85cab865eeabc0dfaa69062d62bd","filename":"src/Mvc/Mvc.ViewFeatures/src/ExpressionHelper.cs","status":"modified","additions":15,"deletions":0,"changes":15,"blob_url":"https://github.com/jaslawinMs/aspnetcore/blob/c6679258a6fa3c8c72496db5d4806881890f564b/src%2FMvc%2FMvc.ViewFeatures%2Fsrc%2FExpressionHelper.cs","raw_url":"https://github.com/jaslawinMs/aspnetcore/raw/c6679258a6fa3c8c72496db5d4806881890f564b/src%2FMvc%2FMvc.ViewFeatures%2Fsrc%2FExpressionHelper.cs","contents_url":"https://api.github.com/repos/jaslawinMs/aspnetcore/contents/src%2FMvc%2FMvc.ViewFeatures%2Fsrc%2FExpressionHelper.cs?ref=c6679258a6fa3c8c72496db5d4806881890f564b","patch":"@@ -7,12 +7,16 @@\n using System.Linq;\n using System.Linq.Expressions;\n using System.Reflection;\n+using System.Reflection.Metadata;\n+using System.Runtime.CompilerServices;\n using System.Text;\n \n namespace Microsoft.AspNetCore.Mvc.ViewFeatures;\n \n internal static class ExpressionHelper\n {\n+    private static readonly ConditionalWeakTable<MethodInfo, MethodInfo> _indexerCache = new();\n+\n     public static string GetUncachedExpressionText(LambdaExpression expression)\n         => GetExpressionText(expression, expressionTextCache: null);\n \n@@ -239,6 +243,11 @@ public static bool IsSingleArgumentIndexer(Expression expression)\n             return false;\n         }\n \n+        if (!MetadataUpdater.IsSupported && _indexerCache.TryGetValue(methodExpression.Method, out _))\n+        {\n+            return true;\n+        }\n+\n         // Check whether GetDefaultMembers() (if present in CoreCLR) would return a member of this type. Compiler\n         // names the indexer property, if any, in a generated [DefaultMember] attribute for the containing type.\n         var declaringType = methodExpression.Method.DeclaringType;\n@@ -255,6 +264,12 @@ public static bool IsSingleArgumentIndexer(Expression expression)\n             if ((string.Equals(defaultMember.MemberName, property.Name, StringComparison.Ordinal) &&\n                 property.GetMethod == methodExpression.Method))\n             {\n+                // Custom reflection types can expose changing metadata even without Hot Reload.\n+                if (!MetadataUpdater.IsSupported && declaringType.GetType() == typeof(object).GetType())\n+                {\n+                    _indexerCache.AddOrUpdate(methodExpression.Method, methodExpression.Method);\n+                }\n+\n                 return true;\n             }\n         }"},{"sha":"82c74b2c47ea641ce0932b5af66a75c14a0dd2d4","filename":"src/Mvc/Mvc.ViewFeatures/test/ExpressionHelperTest.cs","status":"modified","additions":141,"deletions":0,"changes":141,"blob_url":"https://github.com/jaslawinMs/aspnetcore/blob/c6679258a6fa3c8c72496db5d4806881890f564b/src%2FMvc%2FMvc.ViewFeatures%2Ftest%2FExpressionHelperTest.cs","raw_url":"https://github.com/jaslawinMs/aspnetcore/raw/c6679258a6fa3c8c72496db5d4806881890f564b/src%2FMvc%2FMvc.ViewFeatures%2Ftest%2FExpressionHelperTest.cs","contents_url":"https://api.github.com/repos/jaslawinMs/aspnetcore/contents/src%2FMvc%2FMvc.ViewFeatures%2Ftest%2FExpressionHelperTest.cs?ref=c6679258a6fa3c8c72496db5d4806881890f564b","patch":"@@ -3,6 +3,12 @@\n \n using System.Collections.Concurrent;\n using System.Linq.Expressions;\n+using System.Reflection;\n+using System.Reflection.Emit;\n+using System.Reflection.Metadata;\n+using System.Runtime.CompilerServices;\n+using Microsoft.AspNetCore.Mvc.ModelBinding;\n+using Moq;\n \n namespace Microsoft.AspNetCore.Mvc.ViewFeatures;\n \n@@ -453,6 +459,141 @@ public void GetExpressionText_WithinALoop_ReturnsExpectedText()\n         }\n     }\n \n+    [Fact]\n+    public void IsSingleArgumentIndexer_RepeatedClassificationMatchesMetadataUpdateSupport()\n+    {\n+        Expression<Func<List<TestModel>, TestModel>> expression = model => model[0];\n+        var call = Assert.IsAssignableFrom<MethodCallExpression>(expression.Body);\n+        for (var index = 0; index < 64; index++)\n+        {\n+            Assert.True(ExpressionHelper.IsSingleArgumentIndexer(call));\n+        }\n+\n+        var before = GC.GetAllocatedBytesForCurrentThread();\n+        for (var index = 0; index < 32; index++)\n+        {\n+            Assert.True(ExpressionHelper.IsSingleArgumentIndexer(call));\n+        }\n+        var allocated = GC.GetAllocatedBytesForCurrentThread() - before;\n+\n+        if (MetadataUpdater.IsSupported)\n+        {\n+            Assert.True(allocated > 0);\n+        }\n+        else\n+        {\n+            Assert.Equal(0L, allocated);\n+        }\n+    }\n+\n+    [Fact]\n+    public void GetExpressionText_RetainedExpressionUsesCurrentIndex()\n+    {\n+        var provider = new ModelExpressionProvider(new EmptyModelMetadataProvider());\n+        var index = 0;\n+        Expression<Func<List<TestModel>, string>> expression = model => model[index].Name;\n+\n+        Assert.Equal(\"[0].Name\", provider.GetExpressionText(expression));\n+\n+        index = 2;\n+\n+        Assert.Equal(\"[2].Name\", provider.GetExpressionText(expression));\n+    }\n+\n+    [Fact]\n+    public void IsSingleArgumentIndexer_DoesNotCacheMutableReflectionMetadata()\n+    {\n+        Expression<Func<List<TestModel>, TestModel>> expression = model => model[0];\n+        var originalCall = Assert.IsAssignableFrom<MethodCallExpression>(expression.Body);\n+        var originalMethod = originalCall.Method;\n+        var indexerName = originalMethod.DeclaringType.GetCustomAttribute<DefaultMemberAttribute>().MemberName;\n+        var defaultMemberName = indexerName;\n+        var declaringType = new Mock<TypeDelegator>(originalMethod.DeclaringType) { CallBase = true };\n+        var method = new Mock<MethodInfo>();\n+        var property = new Mock<PropertyInfo>();\n+        method.SetupGet(value => value.DeclaringType).Returns(declaringType.Object);\n+        method.SetupGet(value => value.Name).Returns(originalMethod.Name);\n+        method.SetupGet(value => value.ReturnType).Returns(originalMethod.ReturnType);\n+        method.SetupGet(value => value.Attributes).Returns(originalMethod.Attributes);\n+        method.SetupGet(value => value.CallingConvention).Returns(originalMethod.CallingConvention);\n+        method.Setup(value => value.GetParameters()).Returns(originalMethod.GetParameters);\n+        property.SetupGet(value => value.Name).Returns(indexerName);\n+        property.SetupGet(value => value.GetMethod).Returns(method.Object);\n+        declaringType.Setup(value => value.GetCustomAttributes(typeof(DefaultMemberAttribute), It.IsAny<bool>()))\n+            .Returns(() => new Attribute[] { new DefaultMemberAttribute(defaultMemberName) });\n+        declaringType.Setup(value => value.GetProperties(It.IsAny<BindingFlags>()))\n+            .Returns(new[] { property.Object });\n+        declaringType.Setup(value => value.IsAssignableFrom(It.IsAny<Type>()))\n+            .Returns((Type value) => originalMethod.DeclaringType.IsAssignableFrom(value));\n+        var call = Expression.Call(originalCall.Object, method.Object, originalCall.Arguments);\n+\n+        Assert.True(ExpressionHelper.IsSingleArgumentIndexer(call));\n+\n+        defaultMemberName = nameof(TestModel.Name);\n+\n+        Assert.False(ExpressionHelper.IsSingleArgumentIndexer(call));\n+\n+        defaultMemberName = indexerName;\n+\n+        Assert.True(ExpressionHelper.IsSingleArgumentIndexer(call));\n+    }\n+\n+    [Fact]\n+    public void IsSingleArgumentIndexer_DoesNotRetainCollectibleMetadata()\n+    {\n+        var (type, method) = ExerciseCollectibleIndexer();\n+        for (var attempt = 0; attempt < 10; attempt++)\n+        {\n+            GC.Collect();\n+            GC.WaitForPendingFinalizers();\n+            GC.Collect();\n+            if (!IsAlive(type) && !IsAlive(method))\n+            {\n+                break;\n+            }\n+        }\n+\n+        Assert.False(IsAlive(type));\n+        Assert.False(IsAlive(method));\n+    }\n+\n+    [MethodImpl(MethodImplOptions.NoInlining)]\n+    private static (WeakReference<Type> Type, WeakReference<MethodInfo> Method) ExerciseCollectibleIndexer()\n+    {\n+        const string IndexerName = \"Entry\";\n+        var assembly = AssemblyBuilder.DefineDynamicAssembly(\n+            new AssemblyName(\"CollectibleIndexer\" + Guid.NewGuid().ToString(\"N\")), AssemblyBuilderAccess.RunAndCollect);\n+        var module = assembly.DefineDynamicModule(\"Indexers\");\n+        var builder = module.DefineType(\"Indexer\", TypeAttributes.Public);\n+        builder.DefineDefaultConstructor(MethodAttributes.Public);\n+        builder.SetCustomAttribute(new CustomAttributeBuilder(\n+            typeof(DefaultMemberAttribute).GetConstructor(new[] { typeof(string) }), new object[] { IndexerName }));\n+        var getter = builder.DefineMethod(\"get_\" + IndexerName,\n+            MethodAttributes.Public | MethodAttributes.SpecialName | MethodAttributes.HideBySig,\n+            typeof(string), new[] { typeof(int) });\n+        var il = getter.GetILGenerator();\n+        il.Emit(OpCodes.Ldstr, \"value\");\n+        il.Emit(OpCodes.Ret);\n+        builder.DefineProperty(IndexerName, PropertyAttributes.None, typeof(string), new[] { typeof(int) })\n+            .SetGetMethod(getter);\n+        var type = builder.CreateType();\n+        var method = type.GetProperty(IndexerName).GetMethod;\n+        Assert.Equal(\"value\", method.Invoke(Activator.CreateInstance(type), new object[] { 3 }));\n+        var parameter = Expression.Parameter(type, \"model\");\n+        var call = Expression.Call(parameter, method, Expression.Constant(3));\n+\n+        Assert.True(ExpressionHelper.IsSingleArgumentIndexer(call));\n+        Assert.Equal(\"[3]\", ExpressionHelper.GetUncachedExpressionText(Expression.Lambda(call, parameter)));\n+\n+        return (new WeakReference<Type>(type), new WeakReference<MethodInfo>(method));\n+    }\n+\n+    [MethodImpl(MethodImplOptions.NoInlining)]\n+    private static bool IsAlive<T>(WeakReference<T> reference) where T : class\n+    {\n+        return reference.TryGetTarget(out _);\n+    }\n+\n     private class TestModel\n     {\n         public string Name { get; set; }"}]}