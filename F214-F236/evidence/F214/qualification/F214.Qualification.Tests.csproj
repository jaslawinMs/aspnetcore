<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net12.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);QueryStringEnumerable_In_WebUtilities</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RuntimeFrameworkVersion>12.0.0-alpha.1.26557.102</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <Using Include="Xunit" />
    <Compile Include="F214NullGuardQualificationTests.cs" />
    <Compile Include="$(SourceGraph)\src\Shared\Dictionary\AdaptiveCapacityDictionary.cs" />
    <Compile Include="$(SourceGraph)\src\Shared\Debugger\DictionaryDebugView.cs" />
    <Compile Include="$(SourceGraph)\src\Shared\Debugger\DictionaryItemDebugView.cs" />
    <Compile Include="$(SourceGraph)\src\Shared\Debugger\StringValuesDictionaryDebugView.cs" />
    <Compile Include="$(SourceGraph)\src\Shared\QueryStringEnumerable.cs" />
    <Compile Include="$(SourceGraph)\src\Shared\QueryStringDecoder.cs" />
    <Compile Include="$(SourceGraph)\src\Shared\HttpRuleParser.cs" />
    <Compile Include="$(SourceGraph)\src\Shared\HttpParseResult.cs" />
    <Compile Include="$(SourceGraph)\src\Http\Shared\CookieHeaderParserShared.cs" />
    <Compile Include="$(SourceGraph)\src\Http\Http\src\Features\QueryFeature.cs" />
    <Compile Include="$(SourceGraph)\src\Http\Http\src\QueryCollectionInternal.cs" />
    <Compile Include="$(SourceGraph)\src\Http\Http\src\Internal\RequestCookieCollection.cs" />
    <Compile Include="$(SourceGraph)\src\Shared\test\Shared.Tests\AdaptiveCapacityDictionaryTests.cs" />
    <Compile Include="$(SourceGraph)\src\Http\Http\test\Features\QueryFeatureTests.cs" />
    <Compile Include="$(SourceGraph)\src\Http\Http\test\RequestCookiesCollectionTests.cs" />
    <Compile Include="$(SourceGraph)\src\Testing\src\ExceptionAssertions.cs" />
    <Compile Include="$(SourceGraph)\src\Testing\src\CultureReplacer.cs" />
  </ItemGroup>
</Project>
