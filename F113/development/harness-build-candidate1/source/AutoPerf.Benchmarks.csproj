<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net12.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RuntimeFrameworkVersion>12.0.0-alpha.1.26562.105</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <AspNetCoreRoot Condition="'$(AspNetCoreRoot)' == ''">C:\src\aspnetcore</AspNetCoreRoot>
    <TestBin>$(AspNetCoreRoot)\artifacts\bin\Microsoft.AspNetCore.Mvc.TagHelpers.Test\Release\net12.0</TestBin>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.13.0" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Mvc\Mvc.TagHelpers\src\Microsoft.AspNetCore.Mvc.TagHelpers.csproj" />
    <Reference Include="$(TestBin)\Microsoft.*.dll"
      Exclude="$(TestBin)\*Test*.dll;$(TestBin)\*Generator*.dll;$(TestBin)\Microsoft.AspNetCore.Mvc.TagHelpers.dll"
      Private="true" />
  </ItemGroup>
  <Target Name="ValidateTestedDependencies" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(TestBin)\Microsoft.AspNetCore.Mvc.TagHelpers.dll')"
      Text="Build the actual MVC TagHelpers owning tests Release first;do not substitute installed ASP.NET assemblies." />
  </Target>
</Project>
