<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net12.0</TargetFramework>
    <RuntimeFrameworkVersion>12.0.0-alpha.1.26562.105</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <Optimize>true</Optimize>
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <BuildProjectReferences>false</BuildProjectReferences>
    <BuildInParallel>false</BuildInParallel>
    <UseSharedCompilation>false</UseSharedCompilation>
    <AspNetCoreRoot Condition="'$(AspNetCoreRoot)' == ''">C:\src\aspnetcore</AspNetCoreRoot>
    <TestBin>$(AspNetCoreRoot)\artifacts\bin\Microsoft.AspNetCore.Components.Endpoints.Tests\Release\net12.0</TestBin>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.13.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="12.0.0-alpha.1.26562.105" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="12.0.0-alpha.1.26562.105" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Components\Components\src\Microsoft.AspNetCore.Components.csproj" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Components\Web\src\Microsoft.AspNetCore.Components.Web.csproj" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Components\Endpoints\src\Microsoft.AspNetCore.Components.Endpoints.csproj" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Http\Http.Abstractions\src\Microsoft.AspNetCore.Http.Abstractions.csproj" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Http\Http.Features\src\Microsoft.AspNetCore.Http.Features.csproj" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Http\Http\src\Microsoft.AspNetCore.Http.csproj" />
    <Reference Include="$(TestBin)\Microsoft.*.dll"
      Exclude="$(TestBin)\*Test*.dll;$(TestBin)\*Generator*.dll;$(TestBin)\Microsoft.AspNetCore.Components.dll;$(TestBin)\Microsoft.AspNetCore.Components.Web.dll;$(TestBin)\Microsoft.AspNetCore.Components.Endpoints.dll;$(TestBin)\Microsoft.AspNetCore.Http.Abstractions.dll;$(TestBin)\Microsoft.AspNetCore.Http.Features.dll;$(TestBin)\Microsoft.AspNetCore.Http.dll"
      Private="true" />
  </ItemGroup>
  <Target Name="ValidateSourceRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(TestBin)\Microsoft.AspNetCore.Components.Endpoints.dll')" Text="First build the actual Release Endpoints test graph. Do not substitute installed ASP.NET Core owners." />
  </Target>
</Project>
