<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net12.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <AspNetCoreRoot Condition="'$(AspNetCoreRoot)' == ''">C:\src\aspnetcore</AspNetCoreRoot>
    <OwnerTargetFramework Condition="'$(TargetFramework)' == 'net462'">net462</OwnerTargetFramework>
    <OwnerTargetFramework Condition="'$(TargetFramework)' == 'net12.0'">netstandard2.0</OwnerTargetFramework>
    <RuntimeFrameworkVersion Condition="'$(TargetFramework)' == 'net12.0'">12.0.0-alpha.1.26562.105</RuntimeFrameworkVersion>
    <RollForward Condition="'$(TargetFramework)' == 'net12.0'">Disable</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="12.0.0-alpha.1.26562.105" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="12.0.0-alpha.1.26562.105" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics" Version="12.0.0-alpha.1.26562.105" />
    <Reference Include="Microsoft.AspNetCore.Authorization">
      <HintPath>$(AspNetCoreRoot)\artifacts\bin\Microsoft.AspNetCore.Authorization\Release\$(OwnerTargetFramework)\Microsoft.AspNetCore.Authorization.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.AspNetCore.Http.Metadata">
      <HintPath>$(AspNetCoreRoot)\artifacts\bin\Microsoft.AspNetCore.Http.Metadata\Release\netstandard2.0\Microsoft.AspNetCore.Http.Metadata.dll</HintPath>
    </Reference>
    <Compile Include="..\shared\ClaimSamples.cs" Link="ClaimSamples.cs" />
    <Compile Include="..\shared\ContractProbes.cs" Link="ContractProbes.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
</Project>
