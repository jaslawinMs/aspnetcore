19 [C:\\Program Files\\dotnet\\shared\\Microsoft.AspNetCore.App]\n  Microsoft.AspNetCore.App 9.0.8 [C:\\Program Files\\dotnet\\shared\\Microsoft.AspNetCore.App]\n  Microsoft.NETCore.App 8.0.19 [C:\\Program Files\\dotnet\\shared\\Microsoft.NETCore.App]\n  Microsoft.NETCore.App 9.0.8 [C:\\Program Files\\dotnet\\shared\\Microsoft.NETCore.App]\n  Microsoft.WindowsDesktop.App 8.0.19 [C:\\Program Files\\dotnet\\shared\\Microsoft.WindowsDesktop.App]\n  Microsoft.WindowsDesktop.App 9.0.8 [C:\\Program Files\\dotnet\\shared\\Microsoft.WindowsDesktop.App]\n\nOther architectures found:\n  x86   [C:\\Program Files (x86)\\dotnet]\n    registered at [HKLM\\SOFTWARE\\dotnet\\Setup\\InstalledVersions\\x86\\InstallLocation]\n\nEnvironment variables:\n  Not set\n\nglobal.json file:\n  Not found\n\nLearn more:\n  https://aka.ms/dotnet/info\n\nDownload .NET:\n  https://aka.ms/dotnet/download","reactions":{"url":"https://api.github.com/repos/dotnet/aspnetcore/issues/63418/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/dotnet/aspnetcore/issues/63418/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/dotnet/aspnetcore/issues/42158","repository_url":"https://api.github.com/repos/dotnet/aspnetcore","labels_url":"https://api.github.com/repos/dotnet/aspnetcore/issues/42158/labels{/name}","comments_url":"https://api.github.com/repos/dotnet/aspnetcore/issues/42158/comments","events_url":"https://api.github.com/repos/dotnet/aspnetcore/issues/42158/events","html_url":"https://github.com/dotnet/aspnetcore/issues/42158","id":1268607941,"node_id":"I_kwDOAQzde85LnWvF","number":42158,"title":"ASP.NET Core SPA Templates Need Better Options for Authentication","user":{"login":"Grauenwolf","id":10627661,"node_id":"MDQ6VXNlcjEwNjI3NjYx","avatar_url":"https://avatars.githubusercontent.com/u/10627661?v=4","gravatar_id":"","url":"https://api.github.com/users/Grauenwolf","html_url":"https://github.com/Grauenwolf","followers_url":"https://api.github.com/users/Grauenwolf/followers","following_url":"https://api.github.com/users/Grauenwolf/following{/other_user}","gists_url":"https://api.github.com/users/Grauenwolf/gists{/gist_id}","starred_url":"https://api.github.com/users/Grauenwolf/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Grauenwolf/subscriptions","organizations_url":"https://api.github.com/users/Grauenwolf/orgs","repos_url":"https://api.github.com/users/Grauenwolf/repos","events_url":"https://api.github.com/users/Grauenwolf/events{/privacy}","received_events_url":"https://api.github.com/users/Grauenwolf/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":1118663032,"node_id":"MDU6TGFiZWwxMTE4NjYzMDMy","url":"https://api.github.com/repos/dotnet/aspnetcore/labels/area-auth","name":"area-auth","color":"5319e7","default":false,"description":"Includes: authentication, authorization, OAuth, OIDC, and access token validation","archived_at":null,"archived_by":null},{"id":1164594371,"node_id":"MDU6TGFiZWwxMTY0NTk0Mzcx","url":"https://api.github.com/repos/dotnet/aspnetcore/labels/feature-spa","name":"feature-spa","color":"bfdadc","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"closed","locked":true,"assignees":[],"milestone":{"url":"https://api.github.com/repos/dotnet/aspnetcore/milestones/1","html_url":"https://github.com/dotnet/aspnetcore/milestone/1","labels_url":"https://api.github.com/repos/dotnet/aspnetcore/milestones/1/labels","id":1533813,"node_id":"MDk6TWlsZXN0b25lMTUzMzgxMw==","number":1,"title":"Discussions","description":null,"creator":{"login":"Eilon","id":202643,"node_id":"MDQ6VXNlcjIwMjY0Mw==","avatar_url":"https://avatars.githubusercontent.com/u/202643?v=4","gravatar_id":"","url":"https://api.github.com/users/Eilon","html_url":"https://github.com/Eilon","followers_url":"https://api.github.com/users/Eilon/followers","following_url":"https://api.github.com/users/Eilon/following{/other_user}","gists_url":"https://api.github.com/users/Eilon/gists{/gist_id}","starred_url":"https://api.github.com/users/Eilon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Eilon/subscriptions","organizations_url":"https://api.github.com/users/Eilon/orgs","repos_url":"https://api.github.com/users/Eilon/repos","events_url":"https://api.github.com/users/Eilon/events{/privacy}","received_events_url":"https://api.github.com/users/Eilon/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":1873,"state":"closed","created_at":"2016-01-22T07:04:21Z","updated_at":"2026-08-19T16:09:06Z","due_on":null,"closed_at":"2026-08-19T16:09:06Z"},"comments":183,"created_at":"2022-06-12T14:56:16Z","updated_at":"2024-05-03T08:34:54Z","closed_at":"2024-01-26T08:00:31Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Is there an existing issue for this?\r\n\r\n- [X] I have searched the existing issues\r\n\r\n### Is your feature request related to a problem? Please describe the problem.\r\n\r\nI am trying to create basic SPA applications that manage their own passwords without the cost and complexity of third-party products like Identity Server. \r\n\r\nOther's I'm talking to just want simple social media authentication.\r\n\r\nWe're all at a loss as to how to achieve this because none of the SPA templates give us any direction on how to proceed. There are out-of-band tutorials we can look at. But they are often incomplete or confusing, which is not acceptable for something that has to be perfect on day one. The phrase, \"I'm learning authentication by trial-and-error\" is quite frightening. \r\n\r\n\r\n### Describe the solution you'd like\r\n\r\nThe SPA templates for Angular, React, Blazor, etc. should include options for...\r\n\r\n* ASP.NET Identity for cookie-based authentication (i.e. not Identity Server)\r\n* Microsoft Identity \r\n* Azure B2C\r\n* Azure Active Directory\r\n* Generic OAuth with JWT template\r\n* any other Microsoft-supported authentication platform\r\n\r\n### Additional context\r\n\r\nWe are regularly seeing posts on Reddit with titles like \"Why is authentication such a XXXX show with .NET 6?\" and \"Does anyone else feel as lost as I do in the .NET Identity documentation?\". The community is having a really hard time with this and needs far better guidance than what we're getting.\r\n","reactions":{"url":"https://api.github.com/repos/dotnet/aspnetcore/issues/42158/reactions","total_count":491,"+1":384,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":58,"rocket":28,"eyes":21},"timeline_url":"https://api.github.com/repos/dotnet/aspnetcore/issues/42158/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/dotnet/aspnetcore/issues/30838","repository_url":"https://api.github.com/repos/dotnet/aspnetcore","labels_url":"https://api.github.com/repos/dotnet/aspnetcore/issues/30838/labels{/name}","comments_url":"https://api.github.com/repos/dotnet/aspnetcore/issues/30838/comments","events_url":"https://api.github.com/repos/dotnet/aspnetcore/issues/30838/events","html_url":"https://github.com/dotnet/aspnetcore/issues/30838","id":829124856,"node_id":"MDU6SXNzdWU4MjkxMjQ4NTY=","number":30838,"title":"Routing issues then using app.MapWhen","user":{"login":"milen-denev","id":36803782,"node_id":"MDQ6VXNlcjM2ODAzNzgy","avatar_url":"https://avatars.githubusercontent.com/u/36803782?v=4","gravatar_id":"","url":"https://api.github.com/users/milen-denev","html_url":"https://github.com/milen-denev","followers_url":"https://api.github.com/users/milen-denev/followers","following_url":"https://api.github.com/users/milen-denev/following{/other_user}","gists_url":"https://api.github.com/users/milen-denev/gists{/gist_id}","starred_url":"https://api.github.com/users/milen-denev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/milen-denev/subscriptions","organizations_url":"https://api.github.com/users/milen-denev/orgs","repos_url":"https://api.github.com/users/milen-denev/repos","events_url":"https://api.github.com/users/milen-denev/events{/privacy}","received_events_url":"https://api.github.com/users/milen-denev/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":1710368741,"node_id":"MDU6TGFiZWwxNzEwMzY4NzQx","url":"https://api.github.com/repos/dotnet/aspnetcore/labels/Needs:%20Attention%20:wave:","name":"Needs: Attention :wave:","color":"3665db","default":false,"description":"This issue needs the attention of a contributor, typically because the OP has provided an update.","archived_at":null,"archived_by":null},{"id":5572431303,"node_id":"LA_kwDOAQzde88AAAABTCSNxw","url":"https://api.github.com/repos/dotnet/aspnetcore/labels/area-networking","name":"area-networking","color":"5319e7","default":false,"description":"Includes servers, yarp, json patch, bedrock, websockets, http client factory, and http abstractions","archived_at":null,"archived_by":null}],"state":"closed","locked":true,"assignees":[],"milestone":null,"comments":9,"created_at":"2021-03-11T12:54:00Z","updated_at":"2023-08-24T23:39:41Z","closed_at":"2021-03-15T20:17:47Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":"resolved","sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"I am trying to have  **WorkspaceId Value**  in the request and I am making checks if it exists using **app.MapWhen**\r\n\r\nIf **httpContext.Request.Query.ContainsKey(\"Workspace\")** doesn't have the Id when it redirects to controller where you choose your Workspace and continue to other controllers\r\n\r\nFirstly I implemented it in an enterprise application. Strangely but in Development environments I didn't have any sigh of issues. \r\nThen I deployed in production environment and it never redirects to the appropriate Controller/Action, it falls in an infinite loops of HTTP Redirect Result of 302 until is blocked by the browser.\r\n\r\nHere is corresponding question (code and screenshots) at stack overflow: https://stackoverflow.com/questions/66581263/routing-in-asp-net-core-not-working-properly-i-need-opinions\r\n\r\nHere is something like a remake of the issue:  https://github.com/Milen666/TestMVCRouting\r\n\r\nIf you click at \"Privacy\" it starts making the redirections, it's not exactly the same issue, but again it has the same behavior (and I think it shouldn't)\r\n\r\nThe flow in the Enterprise should be like this:\r\n\r\n1. Request for https://my.domain.com/\r\n2. app.MapWhen -> Checks if user is authenticated if not gets redirected to login websites\r\n3. (User return to https://my.domain.com/ authenticated)\r\n4. app.MapWhen -> Checks if the request has the WorkspaceId set in (https://my.domain.com/Workspace/My-Guid-498n3/)\r\n5. If it's not then Redirects to choose workspace\r\n6. Returns as https://my.domain.com/Workspace/My-Guid-498n3/Index\r\n\r\nThe flow in the test application I made should be like this: \r\n\r\n1. Request for https://locahost:32555/\r\n2. app.MapWhen -> Checks if the request has WorkspaceId set in (https://locahost:32555/Workspace/My-Guid-498n3/)\r\n3. If it's not then Redirects to choose RoutingController and creates random new Guid\r\n4. Then redirects back to https://locahost:32555/Workspace/My-Guid-498n3/Index\r\n\r\nThen redirects back to https://locahost:32555/Workspace/My-Guid-498n3/Home/Privacy make redirections again and again\r\n","reactions":{"url":"https://api.github.com/repos/dotnet/aspnetcore/issues/30838/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/dotnet/aspnetcore/issues/30838/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/dotnet/aspnetcore/issues/23076","repository_url":"https://api.github.com/repos/dotnet/aspnetcore","labels_url":"https://api.github.com/repos/dotnet/aspnetcore/issues/23076/labels{/name}","comments_url":"https://api.github.com/repos/dotnet/aspnetcore/issues/23076/comments","events_url":"https://api.github.com/repos/dotnet/aspnetcore/issues/23076/events","html_url":"https://github.com/dotnet/aspnetcore/issues/23076","id":640954855,"node_id":"MDU6SXNzdWU2NDA5NTQ4NTU=","number":23076,"title":"CookieAuthentication creates redirect loop if you automatically redirect an authenticated user to the Login page to use a different account","user":{"login":"nillkitty","id":42795372,"node_id":"MDQ6VXNlcjQyNzk1Mzcy","avatar_url":"https://avatars.githubusercontent.com/u/42795372?v=4","gravatar_id":"","url":"https://api.github.com/users/nillkitty","html_url":"https://github.com/nillkitty","followers_url":"https://api.github.com/users/nillkitty/followers","following_url":"https://api.github.com/users/nillkitty/following{/other_user}","gists_url":"https://api.github.com/users/nillkitty/gists{/gist_id}","starred_url":"https://api.github.com/users/nillkitty/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nillkitty/subscriptions","organizations_url":"https://api.github.com/users/nillkitty/orgs","repos_url":"https://api.github.com/users/nillkitty/repos","events_url":"https://api.github.com/users/nillkitty/events{/privacy}","received_events_url":"https://api.github.com/users/nillkitty/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":1118663032,"node_id":"MDU6TGFiZWwxMTE4NjYzMDMy","url":"https://api.github.com/repos/dotnet/aspnetcore/labels/area-auth","name":"area-auth","color":"5319e7","default":false,"description":"Includes: authentication, authorization, OAuth, OIDC, and access token validation","archived_at":null,"archived_by":null}],"state":"closed","locked":true,"assignees":[],"milestone":{"url":"https://api.github.com/repos/dotnet/aspnetcore/milestones/1","html_url":"https://github.com/dotnet/aspnetcore/milestone/1","labels_url":"https://api.github.com/repos/dotnet/aspnetcore/milestones/1/labels","id":1533813,"node_id":"MDk6TWlsZXN0b25lMTUzMzgxMw==","number":1,"title":"Discussions","description":null,"creator":{"login":"Eilon","id":202643,"node_id":"MDQ6VXNlcjIwMjY0Mw==","avatar_url":"https://avatars.githubusercontent.com/u/202643?v=4","gravatar_id":"","url":"https://api.github.com/users/Eilon","html_url":"https://github.com/Eilon","followers_url":"https://api.github.com/users/Eilon/followers","following_url":"https://api.github.com/users/Eilon/following{/other_user}","gists_url":"https://api.github.com/users/Eilon/gists{/gist_id}","starred_url":"https://api.github.com/users/Eilon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Eilon/subscriptions","organizations_url":"https://api.github.com/users/Eilon/orgs","repos_url":"https://api.github.com/users/Eilon/repos","events_url":"https://api.github.com/users/Eilon/events{/privacy}","received_events_url":"https://api.github.com/users/Eilon/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":1873,"state":"closed","created_at":"2016-01-22T07:04:21Z","updated_at":"2026-08-19T16:09:06Z","due_on":null,"closed_at":"2026-08-19T16:09:06Z"},"comments":9,"created_at":"2020-06-18T06:49:32Z","updated_at":"2020-07-23T21:00:25Z","closed_at":"2020-06-23T20:14:30Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":"resolved","sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"\r\n### Describe the bug\r\nI have a use case in which an authenticated user needs to switch accounts and return back to the page they were on.  If they fail this authentication I want them to stay logged in as their currently authenticated account, so I am **not** logging them out first.\r\n\r\nIf I redirect them to the page defined as `LoginPath` and I use the `ReturnUrl` querystring parameter to determine where they should come back to,  ASP.NET takes it upon itself it redirect them back immediately upon hitting the login page even though I did not write this redirect nor did they ever see the page or re-authenticate.  My redirect in combination with this phantom redirect creates a redirect loop and forces me to use a second querystring parameter that is different from the one defined in the CookieAuthenticationOptions just to work around this.\r\n\r\nI would prefer if I could disable this logic so that a user can to sign in as many times as they want.\r\n\r\n### To Reproduce\r\nRedirect an authenticated user to to the page defined as the LogInPath with a query parameter (of the name defined in ReturnUrlParameter) to the page they're currently on.   They will be redirected back even if your login page has no code.    \r\n\r\n### Exceptions (if any)\r\nNone\r\n\r\n### Further technical details\r\n- ASP.NET Core version:  3.1\r\n- Include the output of `dotnet --info`\r\n```\r\n.NET Core SDK (reflecting any global.json):\r\n Version:   3.1.100\r\n Commit:    cd82f021f4\r\n\r\nRuntime Environment:\r\n OS Name:     Windows\r\n OS Version:  10.0.18362\r\n OS Platform: Windows\r\n RID:         win10-x64\r\n Base Path:   C:\\Program Files\\dotnet\\sdk\\3.1.100\\\r\n\r\nHost (useful for support):\r\n  Version: 3.1.0\r\n  Commit:  65f04fb6db\r\n\r\n.NET Core SDKs installed:\r\n  2.1.701 [C:\\Program Files\\dotnet\\sdk]\r\n  3.1.100-preview1-014459 [C:\\Program Files\\dotnet\\sdk]\r\n  3.1.100 [C:\\Program Files\\dotnet\\sdk]\r\n\r\n.NET Core runtimes installed:\r\n  Microsoft.AspNetCore.All 2.1.12 [C:\\Program Files\\dotnet\\shared\\Microsoft.AspNetCore.All]\r\n  Microsoft.AspNetCore.All 2.1.13 [C:\\Program Files\\dotnet\\shared\\Microsoft.AspNetCore.All]\r\n  Microsoft.AspNetCore.All 2.1.14 [C:\\Program Files\\dotnet\\shared\\Microsoft.AspNetCore.All]\r\n  Microsoft.AspNetCore.App 2.1.12 [C:\\Program Files\\dotnet\\shared\\Microsoft.AspNetCore.App]\r\n  Microsoft.AspNetCore.App 2.1.13 [C:\\Program Files\\dotnet\\shared\\Microsoft.AspNetCore.App]\r\n  Microsoft.AspNetCore.App 2.1.14 [C:\\Program Files\\dotnet\\shared\\Microsoft.AspNetCore.App]\r\n  Microsoft.AspNetCore.App 3.1.0-preview1.19508.20 [C:\\Program Files\\dotnet\\shared\\Microsoft.AspNetCore.App]\r\n  Microsoft.AspNetCore.App 3.1.0 [C:\\Program Files\\dotnet\\shared\\Microsoft.AspNetCore.App]\r\n  Microsoft.NETCore.App 2.1.12 [C:\\Program Files\\dotnet\\shared\\Microsoft.NETCore.App]\r\n  Microsoft.NETCore.App 2.1.13 [C:\\Program Files\\dotnet\\shared\\Microsoft.NETCore.App]\r\n  Microsoft.NETCore.App 2.1.14 [C:\\Program Files\\dotnet\\shared\\Microsoft.NETCore.App]\r\n  Microsoft.NETCore.App 3.1.0-preview1.19506.1 [C:\\Program Files\\dotnet\\shared\\Microsoft.NETCore.App]\r\n  Microsoft.NETCore.App 3.1.0 [C:\\Program Files\\dotnet\\shared\\Microsoft.NETCore.App]\r\n  Microsoft.WindowsDesktop.App 3.1.0-preview1.19506.1 [C:\\Program Files\\dotnet\\shared\\Microsoft.WindowsDesktop.App]\r\n  Microsoft.WindowsDesktop.App 3.1.0 [C:\\Program Files\\dotnet\\shared\\Microsoft.WindowsDesktop.App]\r\n\r\nTo install additional .NET Core runtimes or SDKs:\r\n  https://aka.ms/dotnet-download\r\n```\r\n- The IDE (VS / VS Code/ VS4Mac) you're running on, and it's version:  VS 2019 Enterprise\r\n","reactions":{"url":"https://api.github.com/repos/dotnet/aspnetcore/issues/23076/reactions","total_count":0,"+1":0,"-1":0,"laugh"