37e809ead5824bc753a1c3d56f11615bdb1296c5:Directory.Build.props:117:    <DefaultNetFxTargetFramework>net462</DefaultNetFxTargetFramework>
37e809ead5824bc753a1c3d56f11615bdb1296c5:Directory.Build.props:118:    <!-- Current xunit.runner.visualstudio supports net472+/net8.0+ only. So we can't use net462 -->
37e809ead5824bc753a1c3d56f11615bdb1296c5:Directory.Build.props:119:    <DefaultNetFxTargetFramework Condition="'$(IsTestProject)'=='true'">net472</DefaultNetFxTargetFramework>
37e809ead5824bc753a1c3d56f11615bdb1296c5:Directory.Build.props:133:    <!-- xUnit1004 = warns about skipped tests. Make this a non-fatal build warning. -->
37e809ead5824bc753a1c3d56f11615bdb1296c5:Directory.Build.props:134:    <WarningsNotAsErrors>$(WarningsNotAsErrors);xUnit1004</WarningsNotAsErrors>
37e809ead5824bc753a1c3d56f11615bdb1296c5:Directory.Build.props:141:    <!-- don't warn about calling ConfigureAwait in test methods. we already commonly get off the xunit threads because they cause issues. -->
37e809ead5824bc753a1c3d56f11615bdb1296c5:Directory.Build.props:142:    <NoWarn>$(NoWarn);xUnit1030</NoWarn>
37e809ead5824bc753a1c3d56f11615bdb1296c5:Directory.Build.props:144:    <!-- Preserve the existing analyzer baseline when transitive pinning promotes xunit.analyzers. -->
37e809ead5824bc753a1c3d56f11615bdb1296c5:Directory.Build.props:145:    <NoWarn>$(NoWarn);xUnit1053;xUnit2030;xUnit2031</NoWarn>
37e809ead5824bc753a1c3d56f11615bdb1296c5:Directory.Build.props:199:    <DotNetTargetFrameworkFilter Condition="'$(DotNetBuildSourceOnly)' == 'true'">netstandard2.0%3bnetstandard2.1%3bnetcoreapp2.1%3bnetcoreapp3.1%3bnet5.0%3bnet6.0%3bnet7.0%3bnet8.0%3bnet9.0%3bnet10.0%3bnet11.0%3bnet12.0</DotNetTargetFrameworkFilter>
