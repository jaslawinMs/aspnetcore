<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net12.0</TargetFramework>
    <RuntimeFrameworkVersion>12.0.0-alpha.1.26562.105</RuntimeFrameworkVersion>
    <LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TestOutput Condition="'$(TestOutput)' == ''">C:\src\aspnetcore\artifacts\bin\AIApp.E2E.Tests\Release\net12.0</TestOutput>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Playwright" HintPath="$(TestOutput)\Microsoft.Playwright.dll" />
    <Reference Include="Microsoft.Playwright.TestAdapter" HintPath="$(TestOutput)\Microsoft.Playwright.TestAdapter.dll" />
    <Reference Include="Microsoft.VisualStudio.TestPlatform.ObjectModel" HintPath="$(TestOutput)\Microsoft.VisualStudio.TestPlatform.ObjectModel.dll" />
    <Content Include="$(TestOutput)\.playwright\**\*">
      <Link>.playwright\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
