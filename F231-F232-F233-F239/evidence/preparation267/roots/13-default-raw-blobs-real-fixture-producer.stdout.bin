        ThrowIfDisposed();
        ArgumentNullThrowHelper.ThrowIfNull(user);
        return await Store.GetUserNameAsync(user, CancellationToken).ConfigureAwait(false);
    }

    /// <summary>
    /// Sets the given <paramref name="userName" /> for the specified <paramref name="user"/>.
