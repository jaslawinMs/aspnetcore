31:         var item = new TestRazorCompiledItem(typeof(string), "mvc.1.0.view", "/Views/Home/Index.cstml", new object[]
32:         {
33:                 new RazorSourceChecksumAttribute("SHA1", GetChecksum("some import"), "/Views/Home/_ViewImports.cstml"),
34:         });
35: 
36:         // Act
37:         var result = ChecksumValidator.IsRecompilationSupported(item);
38: 
39:         // Assert
40:         Assert.False(result);
41:     }
42: 
