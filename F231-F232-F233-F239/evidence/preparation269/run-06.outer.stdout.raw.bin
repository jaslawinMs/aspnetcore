13: 
14:     [Fact]
15:     public void IsRecompilationSupported_NoChecksumAttributes_ReturnsFalse()
16:     {
17:         // Arrange
18:         var item = new TestRazorCompiledItem(typeof(string), "mvc.1.0.view", "/Views/Home/Index.cstml", new object[] { });
19: 
20:         // Act
21:         var result = ChecksumValidator.IsRecompilationSupported(item);
22: 
23:         // Assert
24:         Assert.False(result);
25:     }
26: 
27:     [Fact]
28:     public void IsRecompilationSupported_NoPrimaryChecksumAttribute_ReturnsFalse()
29:     {
