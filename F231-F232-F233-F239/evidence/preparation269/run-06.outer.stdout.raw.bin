1: // Licensed to the .NET Foundation under one or more agreements.
2: // The .NET Foundation licenses this file to you under the MIT license.
3: 
4: using System.Globalization;
5: using System.Linq;
6: using System.Security.Cryptography;
7: using Microsoft.AspNetCore.Razor.Hosting;
8: using Microsoft.AspNetCore.Razor.Language;
9: 
10: namespace Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation;
11: 
12: internal static class ChecksumValidator
13: {
14:     public static bool IsRecompilationSupported(RazorCompiledItem item)
15:     {
16:         ArgumentNullException.ThrowIfNull(item);
17: 
18:         // A Razor item only supports recompilation if its primary source file has a checksum.
19:         //
20:         // Other files (view imports) may or may not have existed at the time of compilation,
21:         // so we may not have checksums for them.
22:         var checksums = item.GetChecksumMetadata();
23:         return checksums.Any(c => string.Equals(item.Identifier, c.Identifier, StringComparison.OrdinalIgnoreCase));
24:     }
25: 
26:     // Validates that we can use an existing precompiled view by comparing checksums with files on
27:     // disk.
28:     public static bool IsItemValid(RazorProjectFileSystem fileSystem, RazorCompiledItem item)
29:     {
30:         ArgumentNullException.ThrowIfNull(fileSystem);
31:         ArgumentNullException.ThrowIfNull(item);
32: 
33:         var checksums = item.GetChecksumMetadata();
34: 
35:         // The checksum that matches 'Item.Identity' in this list is significant. That represents the main file.
36:         //
37:         // We don't really care about the validation unless the main file exists. This is because we expect
38:         // most sites to have some _ViewImports in common location. That means that in the case you're
39:         // using views from a 3rd party library, you'll always have **some** conflicts.
40:         //
41:         // The presence of the main file with the same content is a very strong signal that you're in a
42:         // development scenario.
43:         var primaryChecksum = checksums
44:             .FirstOrDefault(c => string.Equals(item.Identifier, c.Identifier, StringComparison.OrdinalIgnoreCase));
45:         if (primaryChecksum == null)
46:         {
47:             // No primary checksum, assume valid.
48:             return true;
49:         }
50: 
51:         var projectItem = fileSystem.GetItem(primaryChecksum.Identifier, fileKind: null);
52:         if (!projectItem.Exists)
53:         {
54:             // Main file doesn't exist - assume valid.
55:             return true;
56:         }
57: 
58:         var sourceDocumentChecksum = ComputeChecksum(projectItem, primaryChecksum.ChecksumAlgorithm);
59:         if (!string.Equals(sourceDocumentChecksum.algorithm, primaryChecksum.ChecksumAlgorithm, StringComparison.OrdinalIgnoreCase) ||
60:             !ChecksumsEqual(primaryChecksum.Checksum, sourceDocumentChecksum.checksum))
61:         {
62:             // Main file exists, but checksums not equal.
63:             return false;
64:         }
65: 
66:         for (var i = 0; i < checksums.Count; i++)
67:         {
68:             var checksum = checksums[i];
69:             if (string.Equals(item.Identifier, checksum.Identifier, StringComparison.OrdinalIgnoreCase))
70:             {
71:                 // Ignore primary checksum on this pass.
72:                 continue;
73:             }
74: 
75:             var importItem = fileSystem.GetItem(checksum.Identifier, fileKind: null);
76:             if (!importItem.Exists)
77:             {
78:                 // Import file doesn't exist - assume invalid.
79:                 return false;
80:             }
81: 
82:             sourceDocumentChecksum = ComputeChecksum(importItem, checksum.ChecksumAlgorithm);
83:             if (!string.Equals(sourceDocumentChecksum.algorithm, checksum.ChecksumAlgorithm, StringComparison.OrdinalIgnoreCase) ||
84:                 !ChecksumsEqual(checksum.Checksum, sourceDocumentChecksum.checksum))
85:             {
86:                 // Import file exists, but checksums not equal.
87:                 return false;
88:             }
89:         }
90: 
91:         return true;
92:     }
93: 
94:     private static (byte[] checksum, string algorithm) ComputeChecksum(RazorProjectItem projectItem, string checksumAlgorithm)
95:     {
96:         ArgumentNullException.ThrowIfNull(projectItem);
97: 
98:         Func<Stream, byte[]> hashData;
99:         string algorithmName;
100: 
101:         //only SHA1 and SHA256 are supported.  Default to SHA1
102:         if (nameof(SHA256).Equals(checksumAlgorithm, StringComparison.OrdinalIgnoreCase))
103:         {
104:             hashData = SHA256.HashData;
105:             algorithmName = nameof(SHA256);
106:         }
107:         else
108:         {
109:             hashData = SHA1.HashData;
110:             algorithmName = nameof(SHA1);
111:         }
112: 
113:         using (var stream = projectItem.Read())
114:         {
115:             return (hashData(stream), algorithmName);
116:         }
117:     }
118: 
119:     private static bool ChecksumsEqual(string checksum, byte[] bytes)
120:     {
121:         if (bytes.Length * 2 != checksum.Length)
122:         {
123:             return false;
124:         }
125: 
126:         for (var i = 0; i < bytes.Length; i++)
127:         {
128:             var text = bytes[i].ToString("x2", CultureInfo.InvariantCulture);
129:             if (checksum[i * 2] != text[0] || checksum[i * 2 + 1] != text[1])
130:             {
131:                 return false;
132:             }
133:         }
134: 
135:         return true;
136:     }
137: }
