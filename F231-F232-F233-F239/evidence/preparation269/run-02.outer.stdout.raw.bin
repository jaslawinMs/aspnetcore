=== 37e809ead5824bc753a1c3d56f11615bdb1296c5:src/Mvc/Mvc.Razor.RuntimeCompilation/test/TestInfrastructure/DirectoryNode.cs (decoded display only; original bytes retained) ===
1: ﻿// Licensed to the .NET Foundation under one or more agreements.
2: // The .NET Foundation licenses this file to you under the MIT license.
3: 
4: using System.Diagnostics;
5: 
6: namespace Microsoft.AspNetCore.Razor.Language;
7: 
8: // Internal for testing
9: [DebuggerDisplay("{Path}")]
10: internal class DirectoryNode
11: {
12:     public DirectoryNode(string path)
13:     {
14:         Path = path;
15:     }
16: 
17:     public string Path { get; }
18: 
19:     public List<DirectoryNode> Directories { get; } = new List<DirectoryNode>();
20: 
21:     public List<FileNode> Files { get; } = new List<FileNode>();
22: 
23:     public void AddFile(FileNode fileNode)
24:     {
25:         var filePath = fileNode.Path;
26:         if (!filePath.StartsWith(Path, StringComparison.OrdinalIgnoreCase))
27:         {
28:             throw new InvalidOperationException($"File {fileNode.Path} does not belong to {Path}.");
29:         }
30: 
31:         // Look for the first / that appears in the path after the current directory path.
32:         var directoryPath = GetDirectoryPath(filePath);
33:         var directory = GetOrAddDirectory(this, directoryPath, createIfNotExists: true);
34:         Debug.Assert(directory != null);
35:         directory.Files.Add(fileNode);
36:         fileNode.Directory = directory;
37:     }
38: 
39:     public DirectoryNode GetDirectory(string path)
40:     {
41:         if (!path.StartsWith(Path, StringComparison.OrdinalIgnoreCase))
42:         {
43:             throw new InvalidOperationException($"File {path} does not belong to {Path}.");
44:         }
45: 
46:         return GetOrAddDirectory(this, path);
47:     }
48: 
49:     public IEnumerable<RazorProjectItem> EnumerateItems()
50:     {
51:         foreach (var file in Files)
52:         {
53:             yield return file.ProjectItem;
54:         }
55: 
56:         foreach (var directory in Directories)
57:         {
58:             foreach (var file in directory.EnumerateItems())
59:             {
60:                 yield return file;
61:             }
62:         }
63:     }
64: 
65:     public RazorProjectItem GetItem(string path)
66:     {
67:         if (!path.StartsWith(Path, StringComparison.OrdinalIgnoreCase))
68:         {
69:             throw new InvalidOperationException($"File {path} does not belong to {Path}.");
70:         }
71: 
72:         var directoryPath = GetDirectoryPath(path);
73:         var directory = GetOrAddDirectory(this, directoryPath);
74:         if (directory == null)
75:         {
76:             return new NotFoundProjectItem("/", path);
77:         }
78: 
79:         foreach (var file in directory.Files)
80:         {
81:             var filePath = file.Path;
82:             var directoryLength = directory.Path.Length;
83: 
84:             // path, filePath -> /Views/Home/Index.cshtml
85:             // directory.Path -> /Views/Home/
86:             // We only need to match the file name portion since we've already matched the directory segment.
87:             if (string.Compare(path, directoryLength, filePath, directoryLength, path.Length - directoryLength, StringComparison.OrdinalIgnoreCase) == 0)
88:             {
89:                 return file.ProjectItem;
90:             }
91:         }
92: 
93:         return new NotFoundProjectItem("/", path);
94:     }
95: 
96:     private static string GetDirectoryPath(string path)
97:     {
98:         // /dir1/dir2/file.cshtml -> /dir1/dir2/
99:         var fileNameIndex = path.LastIndexOf('/');
100:         if (fileNameIndex == -1)
101:         {
102:             return path;
103:         }
104: 
105:         return path.Substring(0, fileNameIndex + 1);
106:     }
107: 
108:     private static DirectoryNode GetOrAddDirectory(
109:         DirectoryNode directory,
110:         string path,
111:         bool createIfNotExists = false)
112:     {
113:         Debug.Assert(!string.IsNullOrEmpty(path));
114:         if (path[path.Length - 1] != '/')
115:         {
116:             path += '/';
117:         }
118: 
119:         int index;
120:         while ((index = path.IndexOf('/', directory.Path.Length)) != -1 && index != path.Length)
121:         {
122:             var subDirectory = FindSubDirectory(directory, path);
123: 
124:             if (subDirectory == null)
125:             {
126:                 if (createIfNotExists)
127:                 {
128:                     var directoryPath = path.Substring(0, index + 1); // + 1 to include trailing slash
129:                     subDirectory = new DirectoryNode(directoryPath);
130:                     directory.Directories.Add(subDirectory);
131:                 }
132:                 else
133:                 {
134:                     return null;
135:                 }
136:             }
137: 
138:             directory = subDirectory;
139:         }
140: 
141:         return directory;
142:     }
143: 
144:     private static DirectoryNode FindSubDirectory(DirectoryNode parentDirectory, string path)
145:     {
146:         for (var i = 0; i < parentDirectory.Directories.Count; i++)
147:         {
148:             // ParentDirectory.Path -> /Views/Home/
149:             // CurrentDirectory.Path -> /Views/Home/SubDir/
150:             // Path -> /Views/Home/SubDir/MorePath/File.cshtml
151:             // Each invocation of FindSubDirectory returns the immediate subdirectory along the path to the file.
152: 
153:             var currentDirectory = parentDirectory.Directories[i];
154:             var directoryPath = currentDirectory.Path;
155:             var startIndex = parentDirectory.Path.Length;
156: 
157:             if (string.Compare(path, startIndex, directoryPath, startIndex, directoryPath.Length - startIndex, StringComparison.OrdinalIgnoreCase) == 0)
158:             {
159:                 return currentDirectory;
160:             }
161:         }
162: 
163:         return null;
164:     }
165: }
