1: ﻿// Licensed to the .NET Foundation under one or more agreements.
2: // The .NET Foundation licenses this file to you under the MIT license.
3: 
4: namespace Microsoft.AspNetCore.Razor.Language;
5: 
6: internal class VirtualRazorProjectFileSystem : RazorProjectFileSystem
7: {
8:     private readonly DirectoryNode _root = new DirectoryNode("/");
9: 
10:     public override IEnumerable<RazorProjectItem> EnumerateItems(string basePath)
11:     {
12:         basePath = NormalizeAndEnsureValidPath(basePath);
13:         var directory = _root.GetDirectory(basePath);
14:         return directory?.EnumerateItems() ?? Enumerable.Empty<RazorProjectItem>();
15:     }
16: 
17:     public override RazorProjectItem GetItem(string path)
18:     {
19:         return GetItem(path, fileKind: null);
20:     }
21: 
22:     public override RazorProjectItem GetItem(string path, string fileKind)
23:     {
24:         // We ignore fileKind here because the _root is pre-filled with project items that already have fileKinds defined. This is
25:         // a unique circumstance where the RazorProjectFileSystem is actually pre-filled with all of its project items on construction.
26: 
27:         path = NormalizeAndEnsureValidPath(path);
28:         return _root.GetItem(path) ?? new NotFoundProjectItem(string.Empty, path);
29:     }
30: 
31:     public void Add(RazorProjectItem projectItem)
32:     {
33:         ArgumentNullException.ThrowIfNull(projectItem);
34: 
35:         var filePath = NormalizeAndEnsureValidPath(projectItem.FilePath);
36:         _root.AddFile(new FileNode(filePath, projectItem));
37:     }
38: }
