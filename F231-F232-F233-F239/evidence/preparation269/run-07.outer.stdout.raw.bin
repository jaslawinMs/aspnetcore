113:     [Fact]
114:     public void GetCompilationFailedResult_ReadsContentFromImports()
115:     {
116:         // Arrange
117:         var viewPath = "/Views/Home/Index.cshtml";
118:         var importsPath = "/Views/_MyImports.cshtml";
119:         var fileContent = "@ ";
120:         var importsContent = "@(abc";
121: 
122:         var projectItem = new TestRazorProjectItem(viewPath, fileContent);
123:         var importsItem = new TestRazorProjectItem(importsPath, importsContent);
124:         var codeDocument = GetCodeDocument(projectItem, importsItem);
125:         var csharpDocument = codeDocument.GetCSharpDocument();
126: 
127:         // Act
128:         var compilationResult = CompilationFailedExceptionFactory.Create(codeDocument, csharpDocument.Diagnostics);
129: 
130:         // Assert
131:         Assert.Collection(
132:             compilationResult.CompilationFailures,
133:             failure =>
134:             {
135:                 Assert.Equal(viewPath, failure.SourceFilePath);
136:                 Assert.Collection(failure.Messages,
137:                     message =>
138:                     {
139:                         Assert.Equal(@"A space or line break was encountered after the ""@"" character.  Only valid identifiers, keywords, comments, ""("" and ""{"" are valid at the start of a code block and they must occur immediately following ""@"" with no space in between.",
140:                             message.Message);
141:                     });
142:             },
143:             failure =>
144:             {
145:                 Assert.Equal(importsPath, failure.SourceFilePath);
146:                 Assert.Collection(failure.Messages,
147:                     message =>
148:                     {
149:                         Assert.Equal(@"The explicit expression block is missing a closing "")"" character.  Make sure you have a matching "")"" character for all the ""("" characters within this block, and that none of the "")"" characters are being interpreted as markup.",
150:                         message.Message);
151:                     });
152:             });
153:     }
