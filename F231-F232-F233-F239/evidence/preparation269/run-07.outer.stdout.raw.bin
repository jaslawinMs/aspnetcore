155:     [Fact]
156:     public void GetCompilationFailedResult_GroupsMessages()
157:     {
158:         // Arrange
159:         var viewPath = "views/index.razor";
160:         var viewImportsPath = "views/global.import.cshtml";
161:         var codeDocument = RazorCodeDocument.Create(
162:             Create(viewPath, "View Content"),
163:             new[] { Create(viewImportsPath, "Global Import Content") });
164:         var diagnostics = new[]
165:         {
166:                 GetRazorDiagnostic("message-1", new SourceLocation(1, 2, 17), length: 1),
167:                 GetRazorDiagnostic("message-2", new SourceLocation(viewPath, 1, 4, 6), length: 7),
168:                 GetRazorDiagnostic("message-3", SourceLocation.Undefined, length: -1),
169:                 GetRazorDiagnostic("message-4", new SourceLocation(viewImportsPath, 1, 3, 8), length: 4),
170:             };
171: 
172:         // Act
173:         var result = CompilationFailedExceptionFactory.Create(codeDocument, diagnostics);
174: 
175:         // Assert
176:         Assert.Collection(result.CompilationFailures,
177:         failure =>
178:         {
179:             Assert.Equal(viewPath, failure.SourceFilePath);
180:             Assert.Equal("View Content", failure.SourceFileContent);
181:             Assert.Collection(failure.Messages,
182:                 message =>
183:                 {
184:                     Assert.Equal(diagnostics[0].GetMessage(CultureInfo.CurrentCulture), message.Message);
185:                     Assert.Equal(viewPath, message.SourceFilePath);
186:                     Assert.Equal(3, message.StartLine);
187:                     Assert.Equal(17, message.StartColumn);
188:                     Assert.Equal(3, message.EndLine);
189:                     Assert.Equal(18, message.EndColumn);
190:                 },
191:                 message =>
192:                 {
193:                     Assert.Equal(diagnostics[1].GetMessage(CultureInfo.CurrentCulture), message.Message);
194:                     Assert.Equal(viewPath, message.SourceFilePath);
195:                     Assert.Equal(5, message.StartLine);
196:                     Assert.Equal(6, message.StartColumn);
197:                     Assert.Equal(5, message.EndLine);
198:                     Assert.Equal(13, message.EndColumn);
199:                 },
200:                 message =>
201:                 {
202:                     Assert.Equal(diagnostics[2].GetMessage(CultureInfo.CurrentCulture), message.Message);
203:                     Assert.Equal(viewPath, message.SourceFilePath);
204:                     Assert.Equal(0, message.StartLine);
205:                     Assert.Equal(-1, message.StartColumn);
206:                     Assert.Equal(0, message.EndLine);
207:                     Assert.Equal(-2, message.EndColumn);
208:                 });
209:         },
210:         failure =>
211:         {
212:             Assert.Equal(viewImportsPath, failure.SourceFilePath);
213:             Assert.Equal("Global Import Content", failure.SourceFileContent);
214:             Assert.Collection(failure.Messages,
215:                 message =>
216:                 {
217:                     Assert.Equal(diagnostics[3].GetMessage(CultureInfo.CurrentCulture), message.Message);
218:                     Assert.Equal(viewImportsPath, message.SourceFilePath);
219:                     Assert.Equal(4, message.StartLine);
220:                     Assert.Equal(8, message.StartColumn);
221:                     Assert.Equal(4, message.EndLine);
222:                     Assert.Equal(12, message.EndColumn);
223:                 });
224:         });
225:     }
