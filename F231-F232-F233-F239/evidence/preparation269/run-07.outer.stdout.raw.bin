4: using System.Globalization;
5: using System.Text;
6: using Microsoft.AspNetCore.Razor.Language;
7: using Microsoft.CodeAnalysis;
8: using Microsoft.CodeAnalysis.CSharp;
9: using Microsoft.CodeAnalysis.Text;
10: 
11: namespace Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation;
12: 
13: public class CompilerFailedExceptionFactoryTest
14: {
15:     [Fact]
16:     public void GetCompilationFailedResult_ReadsRazorErrorsFromPage()
17:     {
18:         // Arrange
19:         var viewPath = "/Views/Home/Index.cshtml";
20: 
21:         var fileSystem = new VirtualRazorProjectFileSystem();
22:         var projectItem = new TestRazorProjectItem(viewPath, "<span name=\"@(User.Id\">");
23: 
24:         var razorEngine = RazorProjectEngine.Create(RazorConfiguration.Default, fileSystem).Engine;
25:         var codeDocument = GetCodeDocument(projectItem);
26: 
27:         // Act
28:         razorEngine.Process(codeDocument);
29:         var csharpDocument = codeDocument.GetCSharpDocument();
30:         var compilationResult = CompilationFailedExceptionFactory.Create(codeDocument, csharpDocument.Diagnostics);
31: 
32:         // Assert
33:         var failure = Assert.Single(compilationResult.CompilationFailures);
34:         Assert.Equal(viewPath, failure.SourceFilePath);
35:         var orderedMessages = failure.Messages.OrderByDescending(messages => messages.Message);
36:         Assert.Collection(orderedMessages,
37:             message => Assert.StartsWith(
38:                 @"Unterminated string literal.",
39:                 message.Message),
40:             message => Assert.StartsWith(
41:                 @"The explicit expression block is missing a closing "")"" character.",
42:                 message.Message));
43:     }
44: 
45:     [Fact]
46:     public void GetCompilationFailedResult_WithMissingReferences()
47:     {
48:         // Arrange
49:         var expected = "One or more compilation references may be missing. If you're seeing this in a published application, set 'CopyRefAssembliesToPublishDirectory' to true in your project file to ensure files in the refs directory are published.";
50:         var compilation = CSharpCompilation.Create("Test", options: new CSharpCompilationOptions(OutputKind.DynamicallyLinkedLibrary));
51:         var syntaxTree = CSharpSyntaxTree.ParseText("@class Test { public string Test { get; set; } }");
52:         compilation = compilation.AddSyntaxTrees(syntaxTree);
53:         var emitResult = compilation.Emit(new MemoryStream());
54: 
55:         // Act
56:         var exception = CompilationFailedExceptionFactory.Create(
57:             RazorCodeDocument.Create(RazorSourceDocument.Create("Test", "Index.cshtml"), Enumerable.Empty<RazorSourceDocument>()),
58:             syntaxTree.ToString(),
59:             "Test",
60:             emitResult.Diagnostics);
61: 
62:         // Assert
63:         Assert.Collection(
64:             exception.CompilationFailures,
65:             failure => Assert.Equal(expected, failure.FailureSummary));
66:     }
