{"sha":"95837ac848beda6c84dc17f44be2298dd7414df2","node_id":"C_kwDOAQzde9oAKDk1ODM3YWM4NDhiZWRhNmM4NGRjMTdmNDRiZTIyOThkZDc0MTRkZjI","commit":{"author":{"name":"davidfowl","email":"95136+davidfowl@users.noreply.github.com","date":"2026-10-31T05:42:20Z"},"committer":{"name":"davidfowl","email":"95136+davidfowl@users.noreply.github.com","date":"2026-10-31T05:42:20Z"},"message":"Avoid CollectionsMarshal in BuildKeyToInfoLookup\n\nKeep only the single-lookup TryAdd for the old-tree pass; the new-tree pass\nreturns to TryGetValue + indexer to comply with the no-CollectionsMarshal rule.\n\nCo-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>","tree":{"sha":"e3ffe4aa21d8db03b3f8ffab4dd76dbe92e03ed9","url":"https://api.github.com/repos/dotnet/aspnetcore/git/trees/e3ffe4aa21d8db03b3f8ffab4dd76dbe92e03ed9"},"url":"https://api.github.com/repos/dotnet/aspnetcore/git/commits/95837ac848beda6c84dc17f44be2298dd7414df2","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/dotnet/aspnetcore/commits/95837ac848beda6c84dc17f44be2298dd7414df2","html_url":"https://github.com/dotnet/aspnetcore/commit/95837ac848beda6c84dc17f44be2298dd7414df2","comments_url":"https://api.github.com/repos/dotnet/aspnetcore/commits/95837ac848beda6c84dc17f44be2298dd7414df2/comments","author":{"login":"davidfowl","id":95136,"node_id":"MDQ6VXNlcjk1MTM2","avatar_url":"https://avatars.githubusercontent.com/u/95136?v=4","gravatar_id":"","url":"https://api.github.com/users/davidfowl","html_url":"https://github.com/davidfowl","followers_url":"https://api.github.com/users/davidfowl/followers","following_url":"https://api.github.com/users/davidfowl/following{/other_user}","gists_url":"https://api.github.com/users/davidfowl/gists{/gist_id}","starred_url":"https://api.github.com/users/davidfowl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/davidfowl/subscriptions","organizations_url":"https://api.github.com/users/davidfowl/orgs","repos_url":"https://api.github.com/users/davidfowl/repos","events_url":"https://api.github.com/users/davidfowl/events{/privacy}","received_events_url":"https://api.github.com/users/davidfowl/received_events","type":"User","user_view_type":"public","site_admin":true},"committer":{"login":"davidfowl","id":95136,"node_id":"MDQ6VXNlcjk1MTM2","avatar_url":"https://avatars.githubusercontent.com/u/95136?v=4","gravatar_id":"","url":"https://api.github.com/users/davidfowl","html_url":"https://github.com/davidfowl","followers_url":"https://api.github.com/users/davidfowl/followers","following_url":"https://api.github.com/users/davidfowl/following{/other_user}","gists_url":"https://api.github.com/users/davidfowl/gists{/gist_id}","starred_url":"https://api.github.com/users/davidfowl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/davidfowl/subscriptions","organizations_url":"https://api.github.com/users/davidfowl/orgs","repos_url":"https://api.github.com/users/davidfowl/repos","events_url":"https://api.github.com/users/davidfowl/events{/privacy}","received_events_url":"https://api.github.com/users/davidfowl/received_events","type":"User","user_view_type":"public","site_admin":true},"parents":[{"sha":"cf18e4bd02ccf209299660e94e1c1b9e3036853c","url":"https://api.github.com/repos/dotnet/aspnetcore/commits/cf18e4bd02ccf209299660e94e1c1b9e3036853c","html_url":"https://github.com/dotnet/aspnetcore/commit/cf18e4bd02ccf209299660e94e1c1b9e3036853c"}],"stats":{"total":10,"additions":4,"deletions":6},"files":[{"sha":"79f1c39cfea041149d3f352bcd9b07d9d652812e","filename":"src/Components/Components/src/RenderTree/RenderTreeDiffBuilder.cs","status":"modified","additions":4,"deletions":6,"changes":10,"blob_url":"https://github.com/dotnet/aspnetcore/blob/95837ac848beda6c84dc17f44be2298dd7414df2/src%2FComponents%2FComponents%2Fsrc%2FRenderTree%2FRenderTreeDiffBuilder.cs","raw_url":"https://github.com/dotnet/aspnetcore/raw/95837ac848beda6c84dc17f44be2298dd7414df2/src%2FComponents%2FComponents%2Fsrc%2FRenderTree%2FRenderTreeDiffBuilder.cs","contents_url":"https://api.github.com/repos/dotnet/aspnetcore/contents/src%2FComponents%2FComponents%2Fsrc%2FRenderTree%2FRenderTreeDiffBuilder.cs?ref=95837ac848beda6c84dc17f44be2298dd7414df2","patch":"@@ -4,7 +4,6 @@\n #nullable disable warnings\n \n using System.Diagnostics;\n-using System.Runtime.InteropServices;\n using Microsoft.AspNetCore.Components.HotReload;\n using Microsoft.AspNetCore.Components.Rendering;\n \n@@ -347,19 +346,18 @@ private static Dictionary<object, KeyedItemInfo> BuildKeyToInfoLookup(DiffContex\n             var key = KeyValue(ref frame);\n             if (key != null)\n             {\n-                ref var entry = ref CollectionsMarshal.GetValueRefOrAddDefault(result, key, out var exists);\n-                if (!exists)\n+                if (!result.TryGetValue(key, out var existingEntry))\n                 {\n-                    entry = new KeyedItemInfo(-1, newStartIndex);\n+                    result[key] = new KeyedItemInfo(-1, newStartIndex);\n                 }\n                 else\n                 {\n-                    if (entry.NewIndex >= 0)\n+                    if (existingEntry.NewIndex >= 0)\n                     {\n                         ThrowExceptionForDuplicateKey(key, frame);\n                     }\n \n-                    entry = new KeyedItemInfo(entry.OldIndex, newStartIndex);\n+                    result[key] = new KeyedItemInfo(existingEntry.OldIndex, newStartIndex);\n                 }\n             }\n "}]}