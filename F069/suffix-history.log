commit 801d77ee2ade7a2cab74ea389aeba6bf6c5f32e5
Author: Tem Revil <146881507+TemRevil@users.noreply.github.com>
Date:   Thu Aug 20 15:59:53 2026 +0300

    Reject malformed SNI server names in Kestrel's SniOptionsSelector (#68015)
    
    * Reject malformed SNI server names in Kestrel's SniOptionsSelector
    
    SniOptionsSelector matched the TLS ClientHello server_name against
    configured exact-name and wildcard-suffix entries with no validation
    that the value is a syntactically valid DNS hostname per RFC 6066 §3.
    An EndsWith-based wildcard suffix scan doesn't understand DNS label
    boundaries, so a crafted name (for example one containing an embedded
    null byte) can satisfy the suffix check and match a wildcard entry it
    has no real relationship to.
    
    Added IsValidSniServerName, checked before both the exact-name lookup
    and the wildcard scan. Uri.CheckHostName already rejects empty labels,
    leading dots, non-LDH characters, embedded nulls, and IP literals, but
    it accepts a trailing dot (the DNS root), which RFC 6066 explicitly
    forbids in server_name, so that gets an explicit check. A malformed
    name now falls through to the "*" catch-all like any other
    unrecognized name, or gets the existing SniNotConfiguredForServerName
    exception if none is configured.
    
    Added MalformedServerNameFallsThroughToWildcardOnly and
    MalformedServerNameThrowsWhenNoWildcardOnlyConfigured, covering an
    embedded null, a leading dot, a double dot, and a trailing dot.
    
    * Consolidate SNI server name validation into IsValidSniServerName
    
    Fold the empty-string guard into IsValidSniServerName so the whole
    check lives in one place. This also lets the JIT see that the
    IsNullOrEmpty check guards serverName[^1], avoiding a bounds check
    on that access when the method isn't inlined.
    
    * Reorder SNI validation behind the exact-name lookup
    
    An exact name match no longer runs Uri.CheckHostName, and the null/empty
    guard moves back to the call site now that the trailing dot check uses
    EndsWith.
    
    Add tests for IP literals and for underscore and unicode host names.

diff --git a/src/Servers/Kestrel/Core/src/Internal/SniOptionsSelector.cs b/src/Servers/Kestrel/Core/src/Internal/SniOptionsSelector.cs
index f700cf41cc..0e40d1233a 100644
--- a/src/Servers/Kestrel/Core/src/Internal/SniOptionsSelector.cs
+++ b/src/Servers/Kestrel/Core/src/Internal/SniOptionsSelector.cs
@@ -117,7 +117,7 @@ internal sealed class SniOptionsSelector
     {
         SniOptions? sniOptions = null;
 
-        if (!string.IsNullOrEmpty(serverName) && !_exactNameOptions.TryGetValue(serverName, out sniOptions))
+        if (!string.IsNullOrEmpty(serverName) && !_exactNameOptions.TryGetValue(serverName, out sniOptions) && IsValidSniServerName(serverName))
         {
             foreach (var (suffix, options) in _wildcardPrefixOptions)
             {
@@ -176,6 +176,13 @@ internal sealed class SniOptionsSelector
         return (sslOptions, sniOptions.ClientCertificateMode);
     }
 
+    // RFC 6066 §3 requires the SNI server_name to be a syntactically valid DNS hostname and
+    // forbids a trailing dot. Uri.CheckHostName already rejects empty labels, leading dots,
+    // non-LDH characters, embedded nulls, and IP literals, but it accepts a trailing dot as
+    // the DNS root, so that needs an explicit check. Callers check for null/empty first.
+    private static bool IsValidSniServerName(string serverName)
+        => !serverName.EndsWith('.') && Uri.CheckHostName(serverName) == UriHostNameType.Dns;
+
     public static ValueTask<SslServerAuthenticationOptions> OptionsCallback(TlsHandshakeCallbackContext callbackContext)
     {
         var sniOptionsSelector = (SniOptionsSelector)callbackContext.State!;

