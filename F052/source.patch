+        Assert.Equal("TextContent", Assert.Single(state.Where(p => p.Key == "ContentTypes")).Value);
+        pipeline.Finalize();
+        Assert.Equal(BlockLifecycleState.Inactive, block.LifecycleState);
+        Assert.Equal(2, notifications);
+    }
