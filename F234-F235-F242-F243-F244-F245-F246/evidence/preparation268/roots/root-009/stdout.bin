        var role = CreateTestRole(roleName, useRoleNamePrefixAsRoleName: true);
        IdentityResultAssert.IsSuccess(await roleMgr.CreateAsync(role));
        Assert.NotNull(await roleMgr.FindByNameAsync(roleName));
