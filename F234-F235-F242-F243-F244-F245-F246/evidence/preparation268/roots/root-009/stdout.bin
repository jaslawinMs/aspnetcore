    public virtual Task<int> CountRecoveryCodesAsync(TUser user)
    {
        ThrowIfDisposed();
        var store = GetRecoveryCodeStore();
        ArgumentNullThrowHelper.ThrowIfNull(user);

        return store.CountCodesAsync(user, CancellationToken);
    }

