<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net12.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RuntimeFrameworkVersion>12.0.0-alpha.1.26562.105</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <AspNetCoreRoot Condition="'$(AspNetCoreRoot)' == ''">C:\src\aspnetcore</AspNetCoreRoot>
    <WebTestBin>$(AspNetCoreRoot)\artifacts\bin\Microsoft.AspNetCore.Components.Web.Tests\Release\net12.0</WebTestBin>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.13.0" />
    <ProjectReference Include="$(AspNetCoreRoot)\src\Components\Web\src\Microsoft.AspNetCore.Components.Web.csproj" />
    <Reference Include="$(WebTestBin)\Microsoft.*.dll"
      Exclude="$(WebTestBin)\*Test*.dll;$(WebTestBin)\*Generator*.dll;$(WebTestBin)\Microsoft.AspNetCore.Components.Web.dll"
      Private="true" />
  </ItemGroup>
  <Target Name="ValidateTestedDependencies" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(WebTestBin)\Microsoft.AspNetCore.Components.Web.dll')"
      Text="Build the actual NavLinkTest Release first; do not silently use installed ASP.NET assemblies." />
  </Target>
</Project>
