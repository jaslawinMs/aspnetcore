tions":0,"deletions":65,"changeType":"DELETED"},{"path":"src/Components/Endpoints/src/Discovery/ComponentCollectionBuilder.cs","additions":0,"deletions":72,"changeType":"DELETED"},{"path":"src/Components/Endpoints/src/Discovery/ComponentInfo.cs","additions":0,"deletions":72,"changeType":"DELETED"},{"path":"src/Components/Endpoints/src/Discovery/DefaultRazorComponentApplication.cs","additions":0,"deletions":40,"changeType":"DELETED"},{"path":"src/Components/Endpoints/src/Discovery/IRazorComponentApplication.cs","additions":0,"deletions":50,"changeType":"DELETED"},{"path":"src/Components/Endpoints/src/Discovery/PageCollectionBuilder.cs","additions":0,"deletions":96,"changeType":"DELETED"},{"path":"src/Components/Endpoints/src/Discovery/PageComponentBuilder.cs","additions":0,"deletions":93,"changeType":"DELETED"},{"path":"src/Components/Endpoints/src/Discovery/PageComponentDescriptor.cs","additions":3,"deletions":3,"changeType":"RENAMED"},{"path":"src/Components/Endpoints/src/Discovery/RazorComponentApplication.cs","additions":26,"deletions":10,"changeType":"MODIFIED"},{"path":"src/Components/Endpoints/src/Microsoft.AspNetCore.Components.Endpoints.csproj","additions":1,"deletions":1,"changeType":"MODIFIED"},{"path":"src/Components/Endpoints/src/Rendering/EndpointComponentState.cs","additions":5,"deletions":25,"changeType":"MODIFIED"},{"path":"src/Components/Endpoints/src/Rendering/EndpointHtmlRenderer.Prerendering.cs","additions":2,"deletions":2,"changeType":"MODIFIED"},{"path":"src/Components/Endpoints/src/Rendering/EndpointHtmlRenderer.cs","additions":1,"deletions":1,"changeType":"MODIFIED"},{"path":"src/Components/Endpoints/src/SessionCascadingValueSupplier.cs","additions":1,"deletions":18,"changeType":"MODIFIED"},{"path":"src/Components/Endpoints/src/TempData/TempDataCascadingValueSupplier.cs","additions":1,"deletions":18,"changeType":"MODIFIED"},{"path":"src/Components/Endpoints/test/Builder/RazorComponentsEndpointConventionBuilderExtensionsTest.cs","additions":7,"deletions":8,"changeType":"MODIFIED"},{"path":"src/Components/Endpoints/test/ComponentParameterValueGetterTest.cs","additions":78,"deletions":0,"changeType":"ADDED"},{"path":"src/Components/Endpoints/test/DependencyInjection/ComponentJsonMetadataIsolationTest.cs","additions":4,"deletions":0,"changeType":"MODIFIED"},{"path":"src/Components/Endpoints/test/Discovery/ComponentApplicationBuilderTests.cs","additions":102,"deletions":380,"changeType":"MODIFIED"},{"path":"src/Components/Endpoints/test/Discovery/DescribedComponentDiscoveryTest.cs","additions":96,"deletions":0,"changeType":"ADDED"},{"path":"src/Components/Endpoints/test/EndpointHtmlRendererTest.cs","additions":1,"deletions":0,"changeType":"MODIFIED"},{"path":"src/Components/Endpoints/test/HotReloadServiceTests.cs","additions":15,"deletions":16,"changeType":"MODIFIED"},{"path":"src/Components/Endpoints/test/Microsoft.AspNetCore.Components.Endpoints.Generators.Tests/RazorComponentsMetadataGeneratorComponentTests.cs","additions":558,"deletions":0,"changeType":"ADDED"},{"path":"src/Components/Endpoints/test/Microsoft.AspNetCore.Components.Endpoints.Generators.Tests/RazorComponentsMetadataGeneratorDiagnosticTests.cs","additions":246,"deletions":0,"changeType":"ADDED"},{"path":"src/Components/Endpoints/test/Microsoft.AspNetCore.Components.Endpoints.Generators.Tests/RazorComponentsMetadataGeneratorSerializationTests.cs","additions":140,"deletions":0,"changeType":"ADDED"},{"path":"src/Components/Endpoints/test/RazorComponentEndpointDataSourceTest.cs","additions":3,"deletions":5,"changeType":"MODIFIED"},{"path":"src/Components/Endpoints/test/RazorComponentEndpointFactoryTest.cs","additions":5,"deletions":5,"changeType":"MODIFIED"},{"path":"src/Components/Endpoints/test/Session/SessionSubscriptionTest.cs","additions":1,"deletions":0,"changeType":"MODIFIED"},{"path":"src/Components/Endpoints/test/TempData/TempDataSubscriptionTest.cs","additions":1,"deletions":0,"changeType":"MODIFIED"},{"path":"src/Components/Server/src/Circuits/CircuitHost.cs","additions":4,"deletions":4,"changeType":"MODIFIED"},{"path":"src/Components/Server/src/Circuits/CircuitJSComponentInterop.cs","additions":2,"deletions":2,"changeType":"MODIFIED"},{"path":"src/Components/Server/src/Circuits/CircuitPersistenceManager.cs","additions":2,"deletions":2,"changeType":"MODIFIED"},{"path":"src/Components/Server/src/Circuits/ComponentDescriptor.cs","additions":5,"deletions":3,"changeType":"MODIFIED"},{"path":"src/Components/Server/src/Circuits/RemoteComponentState.cs","additions":1,"deletions":1,"changeType":"MODIFIED"},{"path":"src/Components/Server/src/Circuits/RemoteRenderer.cs","additions":15,"deletions":6,"changeType":"MODIFIED"},{"path":"src/Components/Server/src/Circuits/ServerComponentDeserializer.cs","additions":15,"deletions":11,"changeType":"MODIFIED"},{"path":"src/Components/Server/src/DependencyInjection/ComponentServiceCollectionExtensions.cs","additions":1,"deletions":1,"changeType":"MODIFIED"},{"path":"src/Components/Server/src/Microsoft.AspNetCore.Components.Server.csproj","additions":0,"deletions":1,"changeType":"MODIFIED"},{"path":"src/Components/Server/test/Circuits/CircuitHostTest.cs","additions":6,"deletions":6,"changeType":"MODIFIED"},{"path":"src/Components/Server/test/Circuits/CircuitPersistenceManagerTest.cs","additions":10,"deletions":4,"changeType":"MODIFIED"},{"path":"src/Components/Server/test/Circuits/RemoteJSRuntimeMetadataTest.cs","additions":2,"deletions":0,"changeType":"MODIFIED"},{"path":"src/Components/Server/test/Circuits/RemoteRendererTest.cs","additions":85,"deletions":1,"changeType":"MODIFIED"},{"path":"src/Components/Server/test/Circuits/ServerComponentDeserializerTest.cs","additions":110,"deletions":2,"changeType":"MODIFIED"},{"path":"src/Components/Server/test/DependencyInjection/ComponentServiceCollectionExtensionsTest.cs","additions":24,"deletions":0,"changeType":"MODIFIED"},{"path":"src/Components/Server/test/Microsoft.AspNetCore.Components.Server.Tests.csproj","additio