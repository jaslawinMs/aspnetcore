<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net12.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <RollForward>Disable</RollForward>
    <RuntimeFrameworkVersion>12.0.0-alpha.1.26568.110</RuntimeFrameworkVersion>
    <GraphOutput Condition="'$(GraphOutput)' == ''">$(MSBuildThisFileDirectory)..\default\artifacts\bin\Microsoft.AspNetCore.OpenApi.Tests\Debug\net12.0</GraphOutput>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GraphOutput)\*.dll" Private="false" />
  </ItemGroup>
</Project>
